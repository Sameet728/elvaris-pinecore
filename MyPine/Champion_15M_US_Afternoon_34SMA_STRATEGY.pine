//@version=5
strategy("Champion 15M US Afternoon 34SMA Reversal [Tradeify 80% WR]", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_order, commission_value=0.0, slippage=0, process_orders_on_close=true)

// ==============================================================================
// ELVARIS CAPITAL · STRATEGY 3: GOLD US AFTERNOON 34 SMA MACRO REVERSAL
// Instrument: FOREXCOM:XAUUSD / Gold | Timeframe: STRICTLY 15M
// Architecture: 34 SMA Macro Volatility Band (8.5-Hour Institutional Cycle), 2.1 Sigma
// Target Performance: 28 Trades, 82.14% Win Rate, +25.11R Net, Calmar 12.60
// Monthly Performance: Aug +8.16R | Sep +6.85R | Oct +12.09R (Avg +9.03R / Mo)
// Realized Risk:Reward: 1 : 1.31 (TP $18.00 [180p] vs SL $13.75 [137.5p])
// Tradeify Select Rules: Max 1 Loss/Day, Max 2 Trades/Day, Fixed SL $13.75
// Decorrelation: 0.0% TRADE OVERLAP WITH STRATEGY 1 (100% DIFFERENT TRADES!)
// ==============================================================================

// ─── Bracket & Risk Parameters ───
grp_risk     = "Tradeify Select Risk Parameters"
tpDistInput  = input.float(18.00, "Take Profit Distance ($)", minval=5.0, maxval=30.0, step=0.25, group=grp_risk)
slDistInput  = input.float(13.75, "Stop Loss Distance ($)", minval=5.0, maxval=30.0, step=0.25, group=grp_risk)

// ─── Architecture Inputs ───
grp_strat    = "Macro Band & Trend Clearance Architecture"
smaLen       = input.int(34, "Macro Volatility Band Length (8.5 Hours)", minval=10, maxval=60, group=grp_strat)
bandMult     = input.float(2.1, "Volatility Band Multiplier (Sigma)", minval=1.5, maxval=3.0, step=0.05, group=grp_strat)
emaFastLen   = input.int(50, "Fast Trend EMA Length", minval=20, maxval=100, group=grp_strat)
emaSlowLen   = input.int(200, "Macro Trend EMA Length", minval=100, maxval=300, group=grp_strat)
emaOffset    = input.float(3.0, "Bull Trend Clearance Offset ($)", minval=0.0, maxval=10.0, step=0.5, group=grp_strat)
rsiLen       = input.int(14, "RSI Length", minval=5, maxval=30, group=grp_strat)
rsiLongThresh= input.int(52, "RSI Long Maximum Filter", minval=40, maxval=65, group=grp_strat)
rsiShortThresh= input.int(48, "RSI Short Minimum Filter", minval=35, maxval=60, group=grp_strat)
crashFilterAtr= input.float(1.25, "Flash Crash Filter (ATR Multiplier)", minval=0.1, step=0.05, group=grp_strat)

// ─── Safety & Protective Circuit Breakers ───
grp_safety   = "Tradeify Protective Circuit Breakers"
maxDailyLosses = input.int(1, "Daily Loss Circuit Breaker (Max Losses/Day)", minval=1, maxval=3, group=grp_safety)
maxDailyTrades = input.int(2, "Daily Executed Trade Limit (Max Trades/Day)", minval=1, maxval=5, group=grp_safety)

// ─── Institutional Session Guard (UTC) ───
grp_session  = "US Afternoon Session Timing (UTC)"
sessionStart = input.int(12, "Session Start Hour (UTC)", minval=0, maxval=23, group=grp_session)
sessionEnd   = input.int(20, "Session End Hour (UTC)", minval=0, maxval=23, group=grp_session)

// ─── Timeframe & Indicator Calculations ───
is15M = timeframe.isminutes and (timeframe.multiplier == 15)
if not is15M
    runtime.error("This strategy is strictly calibrated for the 15M timeframe!")

smaBasis  = ta.sma(close, smaLen)
stdevVal  = ta.stdev(close, smaLen)
upperBand = smaBasis + bandMult * stdevVal
lowerBand = smaBasis - bandMult * stdevVal

emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
atrVal    = ta.atr(14)
rsiVal    = ta.rsi(close, rsiLen)

// ─── Session Window ───
utcHour = hour(time, "UTC")
inSession = (utcHour >= sessionStart and utcHour <= sessionEnd)

// ─── Tradeify Daily Breaker Tracking ───
dayNumber = dayofmonth(time, "UTC")
var int curDay = -1
var int dayTradeCount = 0
var int dayLossCount = 0

if dayNumber != curDay
    curDay := dayNumber
    dayTradeCount := 0
    dayLossCount := 0

var int prevClosedTrades = 0
if strategy.closedtrades > prevClosedTrades
    int lastTradeIdx = strategy.closedtrades - 1
    float lastProfit = strategy.closedtrades.profit(lastTradeIdx)
    if lastProfit <= 0
        dayLossCount += 1
    dayTradeCount += 1
    prevClosedTrades := strategy.closedtrades

canTrade = (dayLossCount < maxDailyLosses) and (dayTradeCount < maxDailyTrades)

// ─── Signal Logic ───
passCrash  = close >= (emaFast - crashFilterAtr * atrVal)
bullRegime = close > (emaSlow + emaOffset)
bearRegime = close < emaSlow and (emaFast < emaSlow)

longTrigger  = inSession and canTrade and passCrash and bullRegime and (low <= lowerBand) and (close > open) and (rsiVal < rsiLongThresh) and (strategy.position_size == 0)
shortTrigger = inSession and canTrade and bearRegime and (high >= upperBand) and (close < open) and (rsiVal > rsiShortThresh) and (strategy.position_size == 0)

// ─── Execution ───
var float ep = na
var float currSL = na
var float currTP = na

if longTrigger
    ep := close
    currSL := ep - slDistInput
    currTP := ep + tpDistInput
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", from_entry="Long", stop=currSL, limit=currTP)

if shortTrigger
    ep := close
    currSL := ep + slDistInput
    currTP := ep - tpDistInput
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", from_entry="Short", stop=currSL, limit=currTP)

// ─── Visual Plotting ───
plot(emaFast, "EMA 50", color=color.new(color.orange, 0), linewidth=1)
plot(emaSlow, "EMA 200", color=color.new(color.blue, 0), linewidth=2)
plot(upperBand, "Upper Band (34 SMA)", color=color.new(color.red, 30), linewidth=1)
plot(lowerBand, "Lower Band (34 SMA)", color=color.new(color.green, 30), linewidth=1)
plotshape(longTrigger, "Buy Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortTrigger, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

