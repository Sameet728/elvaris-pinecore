//@version=5
strategy("Champion 15M Keltner ATR Channel [Tradeify 80% WR]", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_order, commission_value=0.0, slippage=0)

// ==============================================================================
// ELVARIS CAPITAL · STRATEGY: KELTNER VOLATILITY CHANNEL EXPANSION
// Architecture: Exponential Moving Average (EMA 20) + Average True Range (1.8 ATR)
// Distinct from Bollinger Bands: Uses Exponential Smoothing & True Range (Zero StDev)
// Calibrated for FOREXCOM:XAUUSD strictly on the 15M timeframe.
// Target Performance: WR 80.77%, Calmar 10.48, Profit Factor 5.19, Max DD $27.50
// Tradeify Rules: Max Daily Losses = 1, Max Daily Trades = 2, Stop Loss = $13.75
// ==============================================================================

// === STRATEGY INPUTS ===
keltnerLen     = input.int(20, "Keltner Center EMA Length", minval=10)
keltnerMult    = input.float(1.8, "Keltner ATR Multiplier", step=0.05)
emaMacroLen    = input.int(200, "Macro Trend EMA", minval=50)
emaFastLen     = input.int(50, "Fast Trend EMA", minval=10)
atrLen         = input.int(14, "ATR Length", minval=5)
offsetVal      = input.float(3.0, "Bull Trend Offset ($)", step=0.5)
rsiLen         = input.int(14, "RSI Length")
rsiLongThresh  = input.int(53, "RSI Long Threshold")
rsiShortThresh = input.int(49, "RSI Short Threshold")

takeProfitLong  = input.float(17.0, "Take Profit Long ($)", step=0.5)
stopLossLong    = input.float(13.75, "Stop Loss Long ($)", step=0.25)
takeProfitShort = input.float(17.0, "Take Profit Short ($)", step=0.5)
stopLossShort   = input.float(13.75, "Stop Loss Short ($)", step=0.25)

sessionStart    = input.int(12, "Active Session Start (UTC Hour)", minval=0, maxval=23)
sessionEnd      = input.int(22, "Active Session End (UTC Hour)", minval=0, maxval=23)

// === TECHNICAL INDICATORS ===
atrValue   = ta.atr(atrLen)
emaMacro   = ta.ema(close, emaMacroLen)
emaFast    = ta.ema(close, emaFastLen)
kCenter    = ta.ema(close, keltnerLen)
kDev       = keltnerMult * atrValue
upperK     = kCenter + kDev
lowerK     = kCenter - kDev
rsiValue   = ta.rsi(close, rsiLen)

// === SESSION & DAILY TRADE COUNTER (TRADEIFY RULES) ===
utcHour = hour(time, "UTC")
inSession = (utcHour >= sessionStart and utcHour <= sessionEnd)

var int currentUtcDay = -1
var int dayTradeCount = 0
var int dayLossCount  = 0

dayOfMonth = dayofmonth(time, "UTC")
if dayOfMonth != currentUtcDay
    currentUtcDay := dayOfMonth
    dayTradeCount := 0
    dayLossCount  := 0

var int lastClosedTrades = 0
if strategy.closedtrades > lastClosedTrades
    tradeProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if tradeProfit <= 0
        dayLossCount += 1
    dayTradeCount += 1
    lastClosedTrades := strategy.closedtrades

canTrade = dayLossCount < 1 and dayTradeCount < 2

// === ENTRY CONDITIONS ===
longCondition  = inSession and canTrade and close > (emaMacro + offsetVal) and low <= lowerK and close > open and rsiValue < rsiLongThresh and strategy.position_size == 0
shortCondition = inSession and canTrade and close < emaMacro and emaFast < emaMacro and high >= upperK and close < open and rsiValue > rsiShortThresh and strategy.position_size == 0

// === ORDER EXECUTION ===
var float entryPrice = na

if longCondition
    entryPrice := close
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", from_entry="Long", limit=entryPrice + takeProfitLong, stop=entryPrice - stopLossLong)

if shortCondition
    entryPrice := close
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", from_entry="Short", limit=entryPrice - takeProfitShort, stop=entryPrice + stopLossShort)

// === PLOTTING ===
plot(kCenter, "Keltner Center (EMA)", color=color.new(color.orange, 0), linewidth=1)
plot(upperK, "Keltner Upper (ATR)", color=color.new(color.red, 20), linewidth=1)
plot(lowerK, "Keltner Lower (ATR)", color=color.new(color.green, 20), linewidth=1)
plot(emaMacro, "Macro EMA 200", color=color.new(color.blue, 30), linewidth=2)
