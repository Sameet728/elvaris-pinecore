//@version=5
strategy("Champion 15M US Afternoon Reversal [Tradeify 80% WR]", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_order, commission_value=0.0, slippage=0)

// ==============================================================================
// ELVARIS CAPITAL · STRATEGY 2: US AFTERNOON REVERSAL (NY MOMENTUM)
// Calibrated for FOREXCOM:XAUUSD strictly on the 15M timeframe.
// Target Performance: WR 83.33%, Calmar 22.18, Profit Factor 6.55, Max DD $13.75
// Tradeify Rules: Max Daily Losses = 1, Max Daily Trades = 2
// ==============================================================================

// === STRATEGY INPUTS ===
bandLength      = input.int(30, "Bollinger Band Length", minval=10)
bandMult        = input.float(2.0, "Band Multiplier", step=0.05)
emaMacroLen     = input.int(200, "Macro Trend EMA", minval=50)
emaFastLen      = input.int(50, "Fast Trend EMA", minval=10)
atrLen          = input.int(14, "ATR Length", minval=5)
offsetVal       = input.float(2.0, "Bull Trend Offset ($)", step=0.5)
crashFilterAtr  = input.float(1.5, "Flash Crash Filter ATR", step=0.05)
rsiLen          = input.int(14, "RSI Length")
rsiLongThresh   = input.int(52, "RSI Long Threshold")
rsiShortThresh  = input.int(50, "RSI Short Threshold")

takeProfitLong  = input.float(18.0, "Take Profit Long ($)", step=0.5)
stopLossLong    = input.float(13.75, "Stop Loss Long ($)", step=0.25)
takeProfitShort = input.float(18.0, "Take Profit Short ($)", step=0.5)
stopLossShort   = input.float(13.75, "Stop Loss Short ($)", step=0.25)

startHour       = input.int(14, "Session Start Hour (UTC)")
endHour         = input.int(22, "Session End Hour (UTC)")
maxDailyLosses  = input.int(1, "Max Daily Losses (Tradeify Breaker)")
maxDailyTrades  = input.int(2, "Max Daily Trades")

// === INDICATOR CALCULATIONS ===
emaMacro  = ta.ema(close, emaMacroLen)
emaFast   = ta.ema(close, emaFastLen)
atr       = ta.atr(atrLen)
rsiVal    = ta.rsi(close, rsiLen)

smaBand   = ta.sma(close, bandLength)
devBand   = ta.stdev(close, bandLength)
upperBand = smaBand + bandMult * devBand
lowerBand = smaBand - bandMult * devBand

// === TRADEIFY DAILY CIRCUIT BREAKER ===
var int currentDay = -1
var int dayTradeCount = 0
var int dayLossCount = 0

dayOfYear = dayofmonth(time)
if dayOfYear != currentDay
    currentDay := dayOfYear
    dayTradeCount := 0
    dayLossCount := 0

canTrade = (dayLossCount < maxDailyLosses) and (dayTradeCount < maxDailyTrades)
inSession = (hour(time) >= startHour and hour(time) <= endHour)
crashFilterLong = (close >= (emaFast - crashFilterAtr * atr))

longCondition  = inSession and canTrade and crashFilterLong and (close > emaMacro + offsetVal) and (low <= lowerBand) and (close > open) and (rsiVal < rsiLongThresh)
shortCondition = inSession and canTrade and (close < emaMacro) and (emaFast < emaMacro) and (high >= upperBand) and (close < open) and (rsiVal > rsiShortThresh)

if longCondition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", limit=close + takeProfitLong, stop=close - stopLossLong)
    dayTradeCount := dayTradeCount + 1

if shortCondition and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", limit=close - takeProfitShort, stop=close + stopLossShort)
    dayTradeCount := dayTradeCount + 1

// === VISUALS ===
plot(emaMacro, "EMA 200 Macro", color=color.new(color.blue, 0), linewidth=2)
plot(emaFast, "EMA 50 Fast", color=color.new(color.orange, 0), linewidth=1)
plot(upperBand, "Upper Band (30, 2.0)", color=color.new(color.red, 30))
plot(lowerBand, "Lower Band (30, 2.0)", color=color.new(color.green, 30))
