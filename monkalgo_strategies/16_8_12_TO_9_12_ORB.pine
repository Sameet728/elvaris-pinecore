//@version=6
// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║                                                                           ║
// ║   M O N K   A L G O   ·   R A N G E   F A D E                             ║
// ║   Author : Sahil  ·  monkalgo.app                                          ║
// ║                                                                           ║
// ╚═══════════════════════════════════════════════════════════════════════════╝
//
// Failed-Breakout Fade around a fixed opening range. Apply on any entry
// timeframe (1-minute default). All times are America/New_York.
//
//   1) Range   : high / low of 08:12–09:12 NY (start inclusive, end exclusive)
//   2) Short   : after the range is locked, price breaks ABOVE the high, then
//                a bar closes back INSIDE the range → market short
//   3) Long    : price breaks BELOW the low, then closes back INSIDE → market long
//   4) Stop    : ATR × multiplier, locked at the signal bar
//   5) Target  : opposite side of the range  OR  stop-distance × mult  OR  ATR × mult
//   6) Sizing  : fixed contracts  OR  $ risk per trade (from SL distance)
//   7) Cap     : max trades per day (default 1)
// ─────────────────────────────────────────────────────────────────────────────
strategy("Monk Algo · Range Fade — Sahil", shorttitle = "MA·FADE", overlay = true, pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = true, default_qty_type = strategy.percent_of_equity, default_qty_value = 1, initial_capital = 1000000, currency = currency.USD, commission_type = strategy.commission.cash_per_contract, commission_value = 0, margin_long = 0.1, margin_short = 0.1, max_boxes_count = 250, max_lines_count = 500, max_labels_count = 500)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

grpRange = "◆ Range Window (NY)"
rangeStartHour = input.int(8, "Range Start Hour (NY)", minval = 0, maxval = 23, group = grpRange)
rangeStartMinute = input.int(12, "Range Start Minute (NY)", minval = 0, maxval = 59, group = grpRange)
rangeEndHour = input.int(9, "Range End Hour (NY)", minval = 0, maxval = 23, group = grpRange)
rangeEndMinute = input.int(12, "Range End Minute (NY)", minval = 0, maxval = 59, group = grpRange, tooltip = "Bars from start up to (not including) this time build the range. Default 08:12–09:12 NY = the 08:12 through 09:11 bars on a 1-minute chart. First possible trade is the 09:12 bar.")

grpEntry = "◆ Failed Breakout Entry"
requireCloseOutside = input.bool(true, "Require Close Outside First", group = grpEntry, tooltip = "Off: a wick beyond the range is enough to arm the fade, including the same bar that then closes back inside.\nOn (default): a bar must CLOSE outside the range before a later close back inside can trigger.")
maxTradesPerDay = input.int(1, "Max Trades Per Day", minval = 1, maxval = 20, group = grpEntry)

grpAtr = "◆ Stop / Target"
atrLen = input.int(14, "ATR Length", minval = 1, group = grpAtr)
atrSLMult = input.float(2.0, "SL ATR Multiplier", minval = 0.1, step = 0.1, group = grpAtr, tooltip = "Stop = entry ± ATR × this value, locked at the signal bar.")
tpMode = input.string("Other Side of Range", "Take Profit Mode", options = ["Other Side of Range", "Stop Multiple", "ATR Multiple"], group = grpAtr, tooltip = "Other Side of Range: longs target the range high, shorts target the range low.\nStop Multiple: TP distance = ATR stop distance × the multiplier below.\nATR Multiple: TP = entry ± ATR × the ATR TP multiplier.")
slTPMult = input.float(2.0, "TP = Stop ×", minval = 0.1, step = 0.1, group = grpAtr, tooltip = "Used only when Take Profit Mode = Stop Multiple.")
atrTPMult = input.float(0.3, "TP ATR Multiplier", minval = 0.1, step = 0.1, group = grpAtr, tooltip = "Used only when Take Profit Mode = ATR Multiple.")

grpSize = "◆ Position Sizing"
sizeMode = input.string("Risk $ per Trade", "Sizing Mode", options = ["Fixed Contracts", "Risk $ per Trade"], group = grpSize, tooltip = "Fixed Contracts: use Contracts below.\nRisk $ per Trade: qty = Risk $ / (ATR stop distance × $ per point). Point value is auto-detected from the chart symbol.")
fixedQty = input.int(1, "Contracts", minval = 1, group = grpSize)
riskUsd = input.float(10000.0, "Risk Per Trade ($)", minval = 1.0, step = 10.0, group = grpSize)
maxQty = input.int(100, "Max Contracts Cap", minval = 1, group = grpSize)

grpTrade = "◆ Session / Flatten"
useEodClose = input.bool(true, "Force EOD Close", group = grpTrade)
eodHour = input.int(15, "EOD Close Hour (NY)", minval = 0, maxval = 23, group = grpTrade)
eodMinute = input.int(55, "EOD Close Minute (NY)", minval = 0, maxval = 59, group = grpTrade)
noTradeAfterHour = input.int(15, "No Entries After Hour (NY)", minval = 0, maxval = 23, group = grpTrade)
noTradeAfterMinute = input.int(0, "No Entries After Minute (NY)", minval = 0, maxval = 59, group = grpTrade)

grpVis = "◆ Visualization"
showRange = input.bool(true, "Show Range Box", group = grpVis)
showLevels = input.bool(true, "Show Trade SL / TP Lines", group = grpVis)
showPanel = input.bool(true, "Show Info Panel", group = grpVis)
maxPastDaysDrawn = input.int(20, "Max Past Range Days Drawn", minval = 1, maxval = 200, group = grpVis)
maxPastTradesDrawn = input.int(40, "Max Past Trade Levels Drawn", minval = 1, maxval = 200, group = grpVis)
buildColor = input.color(color.new(#7C4DFF, 78), "Range (Building)", group = grpVis)
readyColor = input.color(color.new(#00BFA6, 78), "Range (Ready)", group = grpVis)
longColor = input.color(#00C896, "Long Color", group = grpVis)
shortColor = input.color(#FF5370, "Short Color", group = grpVis)
entryLineColor = input.color(#FFC857, "Entry Line Color", group = grpVis)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TIME (America/New_York)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

nyHour = hour(time, "America/New_York")
nyMinute = minute(time, "America/New_York")
nyTotalMin = nyHour * 60 + nyMinute
nyYear = year(time, "America/New_York")
nyMonth = month(time, "America/New_York")
nyDay = dayofmonth(time, "America/New_York")
nyDayStartTs = timestamp("America/New_York", nyYear, nyMonth, nyDay, 0, 0)
isNewDay = ta.change(time("D", "America/New_York")) != 0

rangeStartNY = rangeStartHour * 60 + rangeStartMinute
rangeEndNY = rangeEndHour * 60 + rangeEndMinute
rangeStartTs = nyDayStartTs + rangeStartNY * 60 * 1000
rangeEndTs = nyDayStartTs + rangeEndNY * 60 * 1000
sessionEndTs = timestamp("America/New_York", nyYear, nyMonth, nyDay, 16, 0, 0)

inRangeBuild = nyTotalMin >= rangeStartNY and nyTotalMin < rangeEndNY
rangeJustEnded = nyTotalMin >= rangeEndNY and nyTotalMin[1] < rangeEndNY
afterRange = nyTotalMin >= rangeEndNY

eodCloseMin = eodHour * 60 + eodMinute
atOrPastEod = nyTotalMin >= eodCloseMin
eodCloseNow = useEodClose and strategy.position_size != 0 and atOrPastEod and nyTotalMin[1] < eodCloseMin
noTradeAfterMin = noTradeAfterHour * 60 + noTradeAfterMinute
pastEntryCutoff = nyTotalMin >= noTradeAfterMin

f_hhmm(int totalMin) =>
    h = math.floor(totalMin / 60)
    m = totalMin % 60
    str.tostring(h) + ":" + (m < 10 ? "0" : "") + str.tostring(m)

fmtNy = f_hhmm(rangeStartNY) + "–" + f_hhmm(rangeEndNY)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INDICATORS + POINT VALUE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

atrVal = ta.atr(atrLen)
slDistLive = not na(atrVal) ? atrVal * atrSLMult : na
tpDistLive = not na(atrVal) ? atrVal * atrTPMult : na

rootU = str.upper(syminfo.root)
fallbackPointValue = switch rootU
    "MNQ" => 2.0
    "NQ" => 20.0
    "MES" => 5.0
    "ES" => 50.0
    "MYM" => 0.5
    "YM" => 5.0
    "M2K" => 5.0
    "RTY" => 50.0
    "MGC" => 10.0
    "GC" => 100.0
    "SIL" => 1000.0
    "SI" => 5000.0
    "MCL" => 100.0
    "CL" => 1000.0
    "NG" => 10000.0
    "MNG" => 10.0
    "6E" => 12.5
    "6B" => 6.25
    "6J" => 12.5
    "BTC" => 5.0
    "MBT" => 0.5
    "ETH" => 50.0
    "MET" => 0.1
    => na

exchangePv = syminfo.pointvalue
pointValue = not na(exchangePv) and exchangePv != 0.0 ? exchangePv : (not na(fallbackPointValue) ? fallbackPointValue : 1.0)

f_qtyFromStop(float stopDist) =>
    riskPerCt = not na(stopDist) and stopDist > 0 and pointValue > 0 ? stopDist * pointValue : na
    raw = not na(riskPerCt) and riskPerCt > 0 ? math.floor(riskUsd / riskPerCt) : 0
    int(math.max(0, math.min(maxQty, raw)))

fixedSizedQty = int(math.min(maxQty, fixedQty))

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RANGE STATE + FAILED-BREAKOUT ARMING
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float orHigh = na
var float orLow = na
var bool rangeReady = false
var int tradesToday = 0
var int pendingDir = 0
var int lastDrawnNyDayStart = na

if isNewDay
    orHigh := na
    orLow := na
    rangeReady := false
    tradesToday := 0
    pendingDir := 0

if inRangeBuild
    if na(orHigh)
        orHigh := high
        orLow := low
    else
        orHigh := math.max(high, orHigh)
        orLow := math.min(low, orLow)

if rangeJustEnded and not na(orHigh) and not na(orLow)
    rangeReady := true
    pendingDir := 0

rangeSize = not na(orHigh) and not na(orLow) ? orHigh - orLow : na
closeInside = rangeReady and not na(orHigh) and not na(orLow) and close < orHigh and close > orLow
sweptHigh = rangeReady and afterRange and not na(orHigh) and high > orHigh
sweptLow = rangeReady and afterRange and not na(orLow) and low < orLow
closedAbove = rangeReady and afterRange and not na(orHigh) and close > orHigh
closedBelow = rangeReady and afterRange and not na(orLow) and close < orLow

if rangeReady and afterRange and strategy.position_size == 0
    if requireCloseOutside
        if closedAbove and not closedBelow
            pendingDir := -1
        else if closedBelow and not closedAbove
            pendingDir := 1
    else
        if sweptHigh and not sweptLow
            pendingDir := -1
        else if sweptLow and not sweptHigh
            pendingDir := 1
        else if sweptHigh and sweptLow
            pendingDir := 0

canTrade = rangeReady and afterRange and strategy.position_size == 0 and tradesToday < maxTradesPerDay and not pastEntryCutoff and not (useEodClose and atOrPastEod) and not na(slDistLive) and slDistLive > 0 and closeInside

useRangeTp = tpMode == "Other Side of Range"
useAtrTp = tpMode == "ATR Multiple"
longTpPrice = useRangeTp ? orHigh : useAtrTp ? (not na(tpDistLive) ? close + tpDistLive : na) : (not na(slDistLive) ? close + slDistLive * slTPMult : na)
shortTpPrice = useRangeTp ? orLow : useAtrTp ? (not na(tpDistLive) ? close - tpDistLive : na) : (not na(slDistLive) ? close - slDistLive * slTPMult : na)
longTpOk = not na(longTpPrice) and longTpPrice > close
shortTpOk = not na(shortTpPrice) and shortTpPrice < close

longSignal = canTrade and pendingDir == 1 and longTpOk
shortSignal = canTrade and pendingDir == -1 and shortTpOk

if longSignal and shortSignal
    longSignal := false
    shortSignal := false

tradeQtyLong = sizeMode == "Fixed Contracts" ? fixedSizedQty : f_qtyFromStop(slDistLive)
tradeQtyShort = sizeMode == "Fixed Contracts" ? fixedSizedQty : f_qtyFromStop(slDistLive)

var float entrySlDist = na
var float entryTpPrice = na
var int entryBarIndex = na

if longSignal and tradeQtyLong >= 1
    slPx = close - slDistLive
    tpPx = longTpPrice
    strategy.entry("Fade Long", strategy.long, qty = tradeQtyLong, comment = "L Fade", alert_message = '{"action":"buy","ticker":"' + syminfo.ticker + '","entry":"' + str.tostring(close, "#.##") + '","sl":"' + str.tostring(slPx, "#.##") + '","tp":"' + str.tostring(tpPx, "#.##") + '","qty":"' + str.tostring(tradeQtyLong) + '","strategy":"Range Failed-Breakout Fade"}')
    strategy.exit("TP/SL Long", from_entry = "Fade Long", limit = tpPx, stop = slPx, comment_profit = "TP", comment_loss = "ATR SL", alert_message = '{"action":"close_long","ticker":"' + syminfo.ticker + '","exit_price":"' + str.tostring(close, "#.##") + '","avg_entry":"' + str.tostring(close, "#.##") + '","strategy":"Range Failed-Breakout Fade"}')
    alert('{"action":"buy","ticker":"' + syminfo.ticker + '","entry":"' + str.tostring(close, "#.##") + '","sl":"' + str.tostring(slPx, "#.##") + '","tp":"' + str.tostring(tpPx, "#.##") + '","qty":"' + str.tostring(tradeQtyLong) + '","strategy":"Range Failed-Breakout Fade"}', alert.freq_once_per_bar_close)
    entrySlDist := slDistLive
    entryTpPrice := tpPx
    tradesToday += 1
    pendingDir := 0

if shortSignal and tradeQtyShort >= 1
    slPx = close + slDistLive
    tpPx = shortTpPrice
    strategy.entry("Fade Short", strategy.short, qty = tradeQtyShort, comment = "S Fade", alert_message = '{"action":"sell","ticker":"' + syminfo.ticker + '","entry":"' + str.tostring(close, "#.##") + '","sl":"' + str.tostring(slPx, "#.##") + '","tp":"' + str.tostring(tpPx, "#.##") + '","qty":"' + str.tostring(tradeQtyShort) + '","strategy":"Range Failed-Breakout Fade"}')
    strategy.exit("TP/SL Short", from_entry = "Fade Short", limit = tpPx, stop = slPx, comment_profit = "TP", comment_loss = "ATR SL", alert_message = '{"action":"close_short","ticker":"' + syminfo.ticker + '","exit_price":"' + str.tostring(close, "#.##") + '","avg_entry":"' + str.tostring(close, "#.##") + '","strategy":"Range Failed-Breakout Fade"}')
    alert('{"action":"sell","ticker":"' + syminfo.ticker + '","entry":"' + str.tostring(close, "#.##") + '","sl":"' + str.tostring(slPx, "#.##") + '","tp":"' + str.tostring(tpPx, "#.##") + '","qty":"' + str.tostring(tradeQtyShort) + '","strategy":"Range Failed-Breakout Fade"}', alert.freq_once_per_bar_close)
    entrySlDist := slDistLive
    entryTpPrice := tpPx
    tradesToday += 1
    pendingDir := 0

justOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
justClosed = strategy.position_size == 0 and strategy.position_size[1] != 0

if justOpened
    entryBarIndex := bar_index

activeSlDist = not na(entrySlDist) ? entrySlDist : slDistLive

if strategy.position_size > 0 and not na(activeSlDist) and not na(entryTpPrice)
    strategy.exit("TP/SL Long", from_entry = "Fade Long", limit = entryTpPrice, stop = strategy.position_avg_price - activeSlDist, comment_profit = "TP", comment_loss = "ATR SL", alert_message = '{"action":"close_long","ticker":"' + syminfo.ticker + '","exit_price":"' + str.tostring(close, "#.##") + '","avg_entry":"' + str.tostring(strategy.position_avg_price, "#.##") + '","strategy":"Range Failed-Breakout Fade"}')

if strategy.position_size < 0 and not na(activeSlDist) and not na(entryTpPrice)
    strategy.exit("TP/SL Short", from_entry = "Fade Short", limit = entryTpPrice, stop = strategy.position_avg_price + activeSlDist, comment_profit = "TP", comment_loss = "ATR SL", alert_message = '{"action":"close_short","ticker":"' + syminfo.ticker + '","exit_price":"' + str.tostring(close, "#.##") + '","avg_entry":"' + str.tostring(strategy.position_avg_price, "#.##") + '","strategy":"Range Failed-Breakout Fade"}')

if eodCloseNow
    strategy.close_all(comment = "EOD Close " + f_hhmm(eodCloseMin) + " NY", alert_message = '{"action":"close_all","ticker":"' + syminfo.ticker + '","exit_price":"' + str.tostring(close, "#.##") + '","reason":"eod_close","strategy":"Range Failed-Breakout Fade"}')

if justClosed and strategy.position_size[1] > 0
    alert('{"action":"close_long","ticker":"' + syminfo.ticker + '","exit_price":"' + str.tostring(close, "#.##") + '","strategy":"Range Failed-Breakout Fade"}', alert.freq_once_per_bar_close)
if justClosed and strategy.position_size[1] < 0
    alert('{"action":"close_short","ticker":"' + syminfo.ticker + '","exit_price":"' + str.tostring(close, "#.##") + '","strategy":"Range Failed-Breakout Fade"}', alert.freq_once_per_bar_close)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VISUALS — Range box + trade levels
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var box todayBox = na
var line todayOrh = na
var line todayOrl = na
var line todayMid = na
var label todayLbl = na
var box[] rangeBoxes = array.new_box()
var line[] rangeHighLines = array.new_line()
var line[] rangeLowLines = array.new_line()
var line[] rangeMidLines = array.new_line()
var label[] rangeLabels = array.new_label()

if isNewDay
    todayBox := na
    todayOrh := na
    todayOrl := na
    todayMid := na
    todayLbl := na

if showRange and inRangeBuild and not na(orHigh) and not na(orLow)
    if na(todayBox)
        todayBox := box.new(left = rangeStartTs, top = orHigh, right = time, bottom = orLow, xloc = xloc.bar_time, bgcolor = buildColor, border_color = color.new(#7C4DFF, 10), border_width = 2, border_style = line.style_solid)
        todayLbl := label.new(x = rangeStartTs, y = orHigh, xloc = xloc.bar_time, text = "◆ RANGE  " + fmtNy + " NY", style = label.style_label_lower_left, color = color.new(#7C4DFF, 10), textcolor = color.white, size = size.small)
    else
        box.set_top(todayBox, orHigh)
        box.set_bottom(todayBox, orLow)
        box.set_right(todayBox, time)
        label.set_y(todayLbl, orHigh)

newRangeToArchive = showRange and rangeJustEnded and rangeReady and not na(orHigh) and not na(orLow) and (na(lastDrawnNyDayStart) or nyDayStartTs != lastDrawnNyDayStart)
if newRangeToArchive
    midPx = (orHigh + orLow) / 2.0
    if not na(todayBox)
        box.set_top(todayBox, orHigh)
        box.set_bottom(todayBox, orLow)
        box.set_left(todayBox, rangeStartTs)
        box.set_right(todayBox, rangeEndTs)
        box.set_bgcolor(todayBox, readyColor)
        box.set_border_color(todayBox, color.new(#00BFA6, 10))
    else
        todayBox := box.new(left = rangeStartTs, top = orHigh, right = rangeEndTs, bottom = orLow, xloc = xloc.bar_time, bgcolor = readyColor, border_color = color.new(#00BFA6, 10), border_width = 2)

    todayOrh := line.new(x1 = rangeEndTs, y1 = orHigh, x2 = sessionEndTs, y2 = orHigh, xloc = xloc.bar_time, color = color.new(#00BFA6, 25), style = line.style_dashed, width = 2)
    todayOrl := line.new(x1 = rangeEndTs, y1 = orLow, x2 = sessionEndTs, y2 = orLow, xloc = xloc.bar_time, color = color.new(#00BFA6, 25), style = line.style_dashed, width = 2)
    todayMid := line.new(x1 = rangeStartTs, y1 = midPx, x2 = rangeEndTs, y2 = midPx, xloc = xloc.bar_time, color = color.new(#4DD0C4, 45), style = line.style_dotted, width = 1)

    rangeTxt = "◆ RANGE  " + fmtNy + " NY   " + str.tostring(rangeSize, "#.##") + " pts"
    if not na(todayLbl)
        label.set_text(todayLbl, rangeTxt)
        label.set_y(todayLbl, orHigh)
        label.set_color(todayLbl, color.new(#00BFA6, 10))
    else
        todayLbl := label.new(x = rangeStartTs, y = orHigh, xloc = xloc.bar_time, text = rangeTxt, style = label.style_label_lower_left, color = color.new(#00BFA6, 10), textcolor = color.white, size = size.small)

    array.push(rangeBoxes, todayBox)
    array.push(rangeHighLines, todayOrh)
    array.push(rangeLowLines, todayOrl)
    array.push(rangeMidLines, todayMid)
    array.push(rangeLabels, todayLbl)
    lastDrawnNyDayStart := nyDayStartTs
    while array.size(rangeBoxes) > maxPastDaysDrawn
        box.delete(array.shift(rangeBoxes))
        line.delete(array.shift(rangeHighLines))
        line.delete(array.shift(rangeLowLines))
        line.delete(array.shift(rangeMidLines))
        label.delete(array.shift(rangeLabels))

bgcolor(inRangeBuild and showRange ? color.new(#7C4DFF, 92) : na, title = "Range Window")

var line liveEntryLine = na
var line liveTpLine = na
var line liveSlLine = na
var label liveEntryLabel = na
var label liveTpLabel = na
var label liveSlLabel = na
var float visEntryPrice = na
var float visTpLevel = na
var float visSlLevel = na
var bool visIsLong = false
var line[] histEntryLines = array.new_line()
var line[] histTpLines = array.new_line()
var line[] histSlLines = array.new_line()
var label[] histEntryLabels = array.new_label()
var label[] histTpLabels = array.new_label()
var label[] histSlLabels = array.new_label()

if showLevels and justOpened and not na(activeSlDist) and not na(entryTpPrice)
    visEntryPrice := strategy.position_avg_price
    visIsLong := strategy.position_size > 0
    visTpLevel := entryTpPrice
    visSlLevel := visIsLong ? visEntryPrice - activeSlDist : visEntryPrice + activeSlDist
    lineStart = na(entryBarIndex) ? bar_index : entryBarIndex
    liveEntryLine := line.new(x1 = lineStart, y1 = visEntryPrice, x2 = bar_index, y2 = visEntryPrice, color = entryLineColor, style = line.style_dashed, width = 1)
    liveTpLine := line.new(x1 = lineStart, y1 = visTpLevel, x2 = bar_index, y2 = visTpLevel, color = longColor, style = line.style_dotted, width = 2)
    liveSlLine := line.new(x1 = lineStart, y1 = visSlLevel, x2 = bar_index, y2 = visSlLevel, color = shortColor, style = line.style_dotted, width = 2)
    liveEntryLabel := label.new(x = bar_index, y = visEntryPrice, text = (visIsLong ? "▲ L ENTRY " : "▼ S ENTRY ") + str.tostring(visEntryPrice, "#.##"), style = label.style_label_left, color = color.new(entryLineColor, 20), textcolor = color.black, size = size.tiny)
    liveTpLabel := label.new(x = bar_index, y = visTpLevel, text = "TP " + str.tostring(visTpLevel, "#.##"), style = label.style_label_left, color = color.new(longColor, 30), textcolor = color.white, size = size.tiny)
    liveSlLabel := label.new(x = bar_index, y = visSlLevel, text = "SL " + str.tostring(visSlLevel, "#.##"), style = label.style_label_left, color = color.new(shortColor, 30), textcolor = color.white, size = size.tiny)

if showLevels and strategy.position_size != 0 and not na(liveTpLine)
    line.set_x2(liveEntryLine, bar_index)
    line.set_x2(liveTpLine, bar_index)
    line.set_x2(liveSlLine, bar_index)
    label.set_x(liveEntryLabel, bar_index)
    label.set_x(liveTpLabel, bar_index)
    label.set_x(liveSlLabel, bar_index)

if showLevels and justClosed and not na(liveTpLine)
    line.set_x2(liveEntryLine, bar_index)
    line.set_x2(liveTpLine, bar_index)
    line.set_x2(liveSlLine, bar_index)
    label.set_x(liveEntryLabel, bar_index)
    label.set_x(liveTpLabel, bar_index)
    label.set_x(liveSlLabel, bar_index)
    array.push(histEntryLines, liveEntryLine)
    array.push(histTpLines, liveTpLine)
    array.push(histSlLines, liveSlLine)
    array.push(histEntryLabels, liveEntryLabel)
    array.push(histTpLabels, liveTpLabel)
    array.push(histSlLabels, liveSlLabel)
    liveEntryLine := na
    liveTpLine := na
    liveSlLine := na
    liveEntryLabel := na
    liveTpLabel := na
    liveSlLabel := na
    visEntryPrice := na
    visTpLevel := na
    visSlLevel := na
    while array.size(histTpLines) > maxPastTradesDrawn
        line.delete(array.shift(histEntryLines))
        line.delete(array.shift(histTpLines))
        line.delete(array.shift(histSlLines))
        label.delete(array.shift(histEntryLabels))
        label.delete(array.shift(histTpLabels))
        label.delete(array.shift(histSlLabels))

if justClosed
    entryBarIndex := na
    entrySlDist := na
    entryTpPrice := na

plotshape(longSignal, "Long Entry", shape.labelup, location.belowbar, longColor, size = size.small, text = "LONG", textcolor = color.white)
plotshape(shortSignal and not longSignal, "Short Entry", shape.labeldown, location.abovebar, shortColor, size = size.small, text = "SHORT", textcolor = color.white)
plotshape(eodCloseNow, "EOD Close", shape.xcross, location.abovebar, color.orange, size = size.tiny, text = "EOD", textcolor = color.orange)

alertcondition(longSignal, title = "Fade Long Entry", message = "MA-FADE LONG | {{ticker}} | {{close}}")
alertcondition(shortSignal, title = "Fade Short Entry", message = "MA-FADE SHORT | {{ticker}} | {{close}}")
alertcondition(justClosed, title = "Trade Exit", message = "MA-FADE EXIT | {{ticker}} | {{close}}")

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INFO PANEL
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table infoTable = table.new(position.top_right, 2, 12, bgcolor = color.new(#0d0b16, 6), border_color = color.new(#3a2f5a, 0), border_width = 1, frame_color = color.new(#7C4DFF, 40), frame_width = 2)

if showPanel and barstate.islast
    pendingTxt = pendingDir == 1 ? "Broke low · waiting close inside" : pendingDir == -1 ? "Broke high · waiting close inside" : rangeReady ? "Waiting breakout" : "Range building"
    pendingCol = pendingDir == 1 ? longColor : pendingDir == -1 ? shortColor : color.gray
    liveQty = sizeMode == "Fixed Contracts" ? fixedSizedQty : f_qtyFromStop(slDistLive)
    sizeTxt = sizeMode == "Fixed Contracts" ? str.tostring(fixedSizedQty) + " ct" : "$" + str.tostring(riskUsd, "#.#") + " → " + str.tostring(liveQty) + " ct"
    risk1Txt = not na(slDistLive) and pointValue > 0 ? "$" + str.tostring(slDistLive * pointValue, "#.##") + "/ct" : "—"
    eodTxt = useEodClose ? f_hhmm(eodCloseMin) + " NY" : "Off"
    cutoffTxt = f_hhmm(noTradeAfterMin) + " NY"
    tpTxt = useRangeTp ? "Other side of range" : useAtrTp ? str.tostring(atrTPMult, "#.#") + " × ATR" : str.tostring(slTPMult, "#.#") + " × stop"

    table.cell(infoTable, 0, 0, "◆ MONK ALGO · Sahil", text_color = #FFC857, text_size = size.small)
    table.cell(infoTable, 1, 0, fmtNy + " NY", text_color = #7C4DFF, text_size = size.small)
    table.cell(infoTable, 0, 1, "Range High", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 1, not na(orHigh) ? str.tostring(orHigh, "#.##") : "—", text_color = longColor, text_size = size.tiny)
    table.cell(infoTable, 0, 2, "Range Low", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 2, not na(orLow) ? str.tostring(orLow, "#.##") : "—", text_color = shortColor, text_size = size.tiny)
    table.cell(infoTable, 0, 3, "Range Size", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 3, not na(rangeSize) ? str.tostring(rangeSize, "#.##") + " pts" : "—", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 0, 4, "Setup", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 4, pendingTxt, text_color = pendingCol, text_size = size.tiny)
    table.cell(infoTable, 0, 5, "TP / SL", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 5, tpTxt + "  ·  SL " + str.tostring(atrSLMult, "#.#") + " ATR", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 0, 6, "Sizing", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 6, sizeTxt, text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 0, 7, "$ / Point", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 7, "$" + str.tostring(pointValue, "#.##") + " (" + rootU + ")", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 0, 8, "Risk / Ct", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 8, risk1Txt, text_color = #FFC857, text_size = size.tiny)
    table.cell(infoTable, 0, 9, "Trades Today", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 9, str.tostring(tradesToday) + " / " + str.tostring(maxTradesPerDay), text_color = tradesToday >= maxTradesPerDay ? shortColor : color.white, text_size = size.tiny)
    table.cell(infoTable, 0, 10, "No Entries After", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 10, cutoffTxt, text_color = pastEntryCutoff ? shortColor : color.white, text_size = size.tiny)
    table.cell(infoTable, 0, 11, "EOD Close", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 11, eodTxt, text_color = #FFC857, text_size = size.tiny)
