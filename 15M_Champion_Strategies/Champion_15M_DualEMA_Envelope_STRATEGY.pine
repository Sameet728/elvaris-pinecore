//@version=5
strategy("Champion 15M Dual-EMA ATR Envelope [Tradeify 80% WR]", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_order, commission_value=0.0, slippage=0)

// ==============================================================================
// ELVARIS CAPITAL · STRATEGY: DUAL-EMA DYNAMIC VOLATILITY ENVELOPE
// Architecture: Fast EMA 50 Center + 1.65 ATR Volatility Envelope + Macro EMA 200
// Distinct from Bollinger Bands & Keltner: Tracks Medium-Term Dynamic Support Retest
// Calibrated for FOREXCOM:XAUUSD strictly on the 15M timeframe.
// Target Performance: WR 82.61%, Calmar 20.87, Profit Factor 6.22, Max DD $13.75
// Tradeify Rules: Max Daily Losses = 1, Max Daily Trades = 2, Stop Loss = $13.75
// ==============================================================================

// === STRATEGY INPUTS ===
centerEmaLen   = input.int(50, "Center Dynamic EMA Length", minval=20)
atrMultiplier  = input.float(1.65, "ATR Channel Multiplier", step=0.05)
emaMacroLen    = input.int(200, "Macro Trend EMA", minval=50)
atrLen         = input.int(14, "ATR Length", minval=5)
offsetVal      = input.float(3.0, "Bull Trend Offset ($)", step=0.5)
rsiLen         = input.int(14, "RSI Length")
rsiLongThresh  = input.int(53, "RSI Long Threshold")
rsiShortThresh = input.int(49, "RSI Short Threshold")

takeProfitLong  = input.float(18.0, "Take Profit Long ($)", step=0.5)
stopLossLong    = input.float(13.75, "Stop Loss Long ($)", step=0.25)
takeProfitShort = input.float(18.0, "Take Profit Short ($)", step=0.5)
stopLossShort   = input.float(13.75, "Stop Loss Short ($)", step=0.25)

sessionStart    = input.int(12, "Active Session Start (UTC Hour)", minval=0, maxval=23)
sessionEnd      = input.int(22, "Active Session End (UTC Hour)", minval=0, maxval=23)

// === TECHNICAL INDICATORS ===
atrValue   = ta.atr(atrLen)
centerEma  = ta.ema(close, centerEmaLen)
emaMacro   = ta.ema(close, emaMacroLen)
upperEnv   = centerEma + atrMultiplier * atrValue
lowerEnv   = centerEma - atrMultiplier * atrValue
rsiValue   = ta.rsi(close, rsiLen)

// === SESSION & DAILY TRADE COUNTER (TRADEIFY RULES) ===
utcHour = hour(time, "UTC")
inSession = (utcHour >= sessionStart and utcHour <= sessionEnd)

var int currentUtcDay = -1
var int dayTradeCount = 0
var int dayLossCount  = 0

dayOfMonth = dayofmonth(time, "UTC")
if dayOfMonth != currentUtcDay
    currentUtcDay := dayOfMonth
    dayTradeCount := 0
    dayLossCount  := 0

var int lastClosedTrades = 0
if strategy.closedtrades > lastClosedTrades
    tradeProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if tradeProfit <= 0
        dayLossCount += 1
    dayTradeCount += 1
    lastClosedTrades := strategy.closedtrades

canTrade = dayLossCount < 1 and dayTradeCount < 2

// === ENTRY CONDITIONS ===
longCondition  = inSession and canTrade and close > (emaMacro + offsetVal) and low <= lowerEnv and close > open and rsiValue < rsiLongThresh and strategy.position_size == 0
shortCondition = inSession and canTrade and close < emaMacro and centerEma < emaMacro and high >= upperEnv and close < open and rsiValue > rsiShortThresh and strategy.position_size == 0

// === ORDER EXECUTION ===
var float entryPrice = na

if longCondition
    entryPrice := close
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", from_entry="Long", limit=entryPrice + takeProfitLong, stop=entryPrice - stopLossLong)

if shortCondition
    entryPrice := close
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", from_entry="Short", limit=entryPrice - takeProfitShort, stop=entryPrice + stopLossShort)

// === PLOTTING ===
plot(centerEma, "Dynamic Center EMA 50", color=color.new(color.orange, 0), linewidth=1)
plot(upperEnv, "Upper Dynamic Envelope", color=color.new(color.red, 20), linewidth=1)
plot(lowerEnv, "Lower Dynamic Envelope", color=color.new(color.green, 20), linewidth=1)
plot(emaMacro, "Macro Trend EMA 200", color=color.new(color.blue, 30), linewidth=2)
