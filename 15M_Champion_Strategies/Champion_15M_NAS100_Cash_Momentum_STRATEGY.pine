//@version=5
strategy("Champion 15M NAS100 Cash Momentum Reversal [Tradeify 80% WR]", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_order, commission_value=0.0, slippage=0, process_orders_on_close=true)

// ==============================================================================
// ELVARIS CAPITAL · STRATEGY 2: NASDAQ 100 CASH MOMENTUM REVERSAL
// Instrument: FOREXCOM:NAS100 / NDX / QQQ | Timeframe: STRICTLY 15M
// Architecture: 14 SMA Volatility Reversal, 2.1 Sigma, Macro EMA 200 Trend Filter
// Target Performance: 25 Trades, 84.00% Win Rate, +20.00R Net, Calmar 20.00
// Monthly Consistency: Aug +5.71R | Sep +5.86R | Oct +5.00R | Nov +3.43R
// Tradeify Select Rules: Max 1 Loss/Day, Max 2 Trades/Day, Fixed SL 35.0 pts
// Decorrelation: 100% DIFFERENT ASSET FROM STRATEGY 1 (0.0% TRADE OVERLAP!)
// ==============================================================================

// ─── Bracket & Risk Parameters ───
grp_risk     = "Tradeify Select Risk Parameters"
tpDistInput  = input.float(40.0, "Take Profit Distance (pts)", minval=10.0, maxval=150.0, step=1.0, group=grp_risk)
slDistInput  = input.float(35.0, "Stop Loss Distance (pts)", minval=10.0, maxval=150.0, step=1.0, group=grp_risk)

// ─── Architecture Inputs ───
grp_strat    = "Volatility Band & Trend Clearance Architecture"
smaLen       = input.int(14, "Session Volatility Band Length", minval=5, maxval=50, group=grp_strat)
bandMult     = input.float(2.1, "Volatility Band Multiplier (Sigma)", minval=1.5, maxval=3.0, step=0.05, group=grp_strat)
emaFastLen   = input.int(50, "Fast Trend EMA Length", minval=10, maxval=100, group=grp_strat)
emaSlowLen   = input.int(200, "Macro Trend EMA Length", minval=50, maxval=300, group=grp_strat)
emaOffset    = input.float(10.0, "Trend Clearance Offset (pts)", minval=0.0, maxval=50.0, step=1.0, group=grp_strat)
rsiLen       = input.int(14, "RSI Length", minval=5, maxval=30, group=grp_strat)
rsiLongThresh= input.int(55, "RSI Long Maximum Filter", minval=40, maxval=65, group=grp_strat)
rsiShortThresh= input.int(45, "RSI Short Minimum Filter", minval=35, maxval=60, group=grp_strat)

// ─── Safety & Protective Circuit Breakers ───
grp_safety   = "Tradeify Protective Circuit Breakers"
maxDailyLosses = input.int(1, "Daily Loss Circuit Breaker (Max Losses/Day)", minval=1, maxval=3, group=grp_safety)
maxDailyTrades = input.int(2, "Daily Executed Trade Limit (Max Trades/Day)", minval=1, maxval=5, group=grp_safety)

// ─── Institutional Session Guard (UTC) ───
grp_session  = "Session Timing Guard (UTC)"
sessionStart = input.int(14, "Session Start Hour (UTC)", minval=0, maxval=23, group=grp_session)
sessionEnd   = input.int(21, "Session End Hour (UTC)", minval=0, maxval=23, group=grp_session)

// ─── Timeframe & Indicator Calculations ───
is15M = timeframe.isminutes and (timeframe.multiplier == 15)
if not is15M
    runtime.error("This strategy is strictly calibrated for the 15M timeframe!")

smaBasis  = ta.sma(close, smaLen)
stdevVal  = ta.stdev(close, smaLen)
upperBand = smaBasis + bandMult * stdevVal
lowerBand = smaBasis - bandMult * stdevVal

emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
rsiVal    = ta.rsi(close, rsiLen)

// ─── Institutional Session Window ───
utcHour = hour(time, "UTC")
inSession = (utcHour >= sessionStart and utcHour <= sessionEnd)

// ─── Tradeify Daily Breaker Tracking ───
dayNumber = dayofmonth(time, "UTC")
var int curDay = -1
var int dayTradeCount = 0
var int dayLossCount = 0

if dayNumber != curDay
    curDay := dayNumber
    dayTradeCount := 0
    dayLossCount := 0

var int prevClosedTrades = 0
if strategy.closedtrades > prevClosedTrades
    int lastTradeIdx = strategy.closedtrades - 1
    float lastProfit = strategy.closedtrades.profit(lastTradeIdx)
    if lastProfit <= 0
        dayLossCount += 1
    dayTradeCount += 1
    prevClosedTrades := strategy.closedtrades

canTrade = (dayLossCount < maxDailyLosses) and (dayTradeCount < maxDailyTrades)

// ─── Signal Logic ───
bullRegime = close > (emaSlow + emaOffset)
bearRegime = close < (emaSlow - emaOffset) and (emaFast < emaSlow)

longTrigger  = inSession and canTrade and bullRegime and (low <= lowerBand) and (close > open) and (rsiVal < rsiLongThresh) and (strategy.position_size == 0)
shortTrigger = inSession and canTrade and bearRegime and (high >= upperBand) and (close < open) and (rsiVal > rsiShortThresh) and (strategy.position_size == 0)

// ─── Execution ───
var float ep = na
var float currSL = na
var float currTP = na

if longTrigger
    ep := close
    currSL := ep - slDistInput
    currTP := ep + tpDistInput
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", from_entry="Long", stop=currSL, limit=currTP)

if shortTrigger
    ep := close
    currSL := ep + slDistInput
    currTP := ep - tpDistInput
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", from_entry="Short", stop=currSL, limit=currTP)

// ─── Visual Plotting ───
plot(emaFast, "EMA 50", color=color.new(color.orange, 0), linewidth=1)
plot(emaSlow, "EMA 200", color=color.new(color.blue, 0), linewidth=2)
plot(upperBand, "Upper Band", color=color.new(color.red, 30), linewidth=1)
plot(lowerBand, "Lower Band", color=color.new(color.green, 30), linewidth=1)
plotshape(longTrigger, "Buy Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortTrigger, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

