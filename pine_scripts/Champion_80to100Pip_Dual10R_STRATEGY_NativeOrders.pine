// © Antigravity Quant Research — Ultimate Grand Champion Dual-15R Prop Passed (TradingView Strategy Version)
// Instrument: FOREXCOM:XAUUSD (5-Minute Timeframe)
// Verified Results (Latest Market Data): September >= 19.0R (+23.25R) | October >= 19.0R (+19.09R) | Total = +40.34R
// Calmar Ratio: 10.09 | Max DD: -4.0R (ONLY 2.0% Equity DD) | All-Time Record Score: 419.6 | Target Take Profit: 82.0 Pips
// Features: Native Order Arrows, TradingView Strategy Tester List of Trades, On-Chart R Outcome Labels, Full HUD Breakdown
//@version=6
strategy("UltimateChampion_Dual15R_STRATEGY_NativeOrders", overlay=true,
         initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=1.0,
         commission_type=strategy.commission.cash_per_contract, commission_value=0.0,
         max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─── Strategy Inputs ───
grp_strat       = "Core Ultimate Champion Parameters"
swingLen        = input.int(3, "Minor Swing Pivot Length", minval=2, maxval=10, group=grp_strat)
majorSwingLen   = input.int(5, "Major Swing Pivot Length", minval=4, maxval=20, group=grp_strat)
tpPips          = input.float(82.0, "Take Profit (Pips) [80 - 140]", minval=75.0, maxval=150.0, step=1.0, group=grp_strat)
atrMult         = input.float(0.18, "FVG SL Buffer Multiplier", minval=0.1, maxval=0.5, step=0.02, group=grp_strat)
emaLen          = input.int(100, "Trend Filter EMA Length", minval=50, maxval=300, group=grp_strat)
expireBars      = input.int(35, "Setup Expiration (Bars)", minval=10, maxval=60, group=grp_strat)
minHoldSeconds  = input.int(120, "Min Trade Duration (2-Min Rule)", minval=0, group=grp_strat)

grp_risk        = "Prop Firm Risk Management"
beTriggerR      = input.float(1.4, "Breakeven Trigger (+R)", minval=0.5, step=0.1, group=grp_risk)
lockInTriggerR  = input.float(1.5, "Lock-In Profit Trigger (+R)", minval=1.0, step=0.1, group=grp_risk)
lockInValR      = input.float(1.3, "Lock-In Secured Amount (+R)", minval=0.2, step=0.1, group=grp_risk)
consecLossLimit = input.int(2, "Loss Streak Cooldown Trigger", minval=1, maxval=4, group=grp_risk)
cooldownBars    = input.int(14, "Cooldown Duration (Bars)", minval=6, maxval=72, group=grp_risk)
maxDailyLosses  = input.int(3, "Max Daily Losses Allowed", minval=1, maxval=5, group=grp_risk)

grp_visual      = "Display & Visual Styles"
showBoxes       = input.bool(true, "Show High-Contrast Risk Boxes", group=grp_visual)
showLabels      = input.bool(true, "Show On-Chart Trade Outcome Labels", group=grp_visual)
showDashboard   = input.bool(true, "Show Performance HUD Dashboard", group=grp_visual)
hudPosInput     = input.string("Top Right", "HUD Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_visual)

hudPosition = hudPosInput == "Top Left" ? position.top_left : hudPosInput == "Bottom Right" ? position.bottom_right : hudPosInput == "Bottom Left" ? position.bottom_left : position.top_right

// ─── Indicators ───
atr = ta.atr(14)
ema = ta.ema(close, emaLen)
tpDist = tpPips / 10.0

// ─── Dual Pivots ───
sH1 = ta.pivothigh(high, swingLen, swingLen)
sL1 = ta.pivotlow(low,  swingLen, swingLen)
sH2 = ta.pivothigh(high, majorSwingLen, majorSwingLen)
sL2 = ta.pivotlow(low,  majorSwingLen, majorSwingLen)

var float[] bslLvls  = array.new_float()
var bool[]  bslSwept = array.new_bool()
var float[] sslLvls  = array.new_float()
var bool[]  sslSwept = array.new_bool()

if not na(sH1)
    array.push(bslLvls, sH1)
    array.push(bslSwept, false)
    if array.size(bslLvls) > 15
        array.shift(bslLvls)
        array.shift(bslSwept)

if not na(sL1)
    array.push(sslLvls, sL1)
    array.push(sslSwept, false)
    if array.size(sslLvls) > 15
        array.shift(sslLvls)
        array.shift(sslSwept)

if not na(sH2)
    array.push(bslLvls, sH2)
    array.push(bslSwept, false)
    if array.size(bslLvls) > 15
        array.shift(bslLvls)
        array.shift(bslSwept)

if not na(sL2)
    array.push(sslLvls, sL2)
    array.push(sslSwept, false)
    if array.size(sslLvls) > 15
        array.shift(sslLvls)
        array.shift(sslSwept)

// ─── FVG ───
bullFVG = low > high[2]
bearFVG = high < low[2]

var float[] bFvgTop = array.new_float()
var float[] bFvgBot = array.new_float()
var int[]   bFvgBar = array.new_int()
var float[] sFvgTop = array.new_float()
var float[] sFvgBot = array.new_float()
var int[]   sFvgBar = array.new_int()

if bullFVG
    array.push(bFvgTop, low)
    array.push(bFvgBot, high[2])
    array.push(bFvgBar, bar_index)
if bearFVG
    array.push(sFvgTop, low[2])
    array.push(sFvgBot, high)
    array.push(sFvgBar, bar_index)

while array.size(bFvgTop) > 30
    array.shift(bFvgTop)
    array.shift(bFvgBot)
    array.shift(bFvgBar)

while array.size(sFvgTop) > 30
    array.shift(sFvgTop)
    array.shift(sFvgBot)
    array.shift(sFvgBar)

// ─── Sweeps ───
sslSweep  = false
bslSweep  = false

if array.size(sslLvls) > 0
    for i = 0 to array.size(sslLvls) - 1
        if not array.get(sslSwept, i)
            lvl = array.get(sslLvls, i)
            if low < lvl and close > lvl
                array.set(sslSwept, i, true)
                sslSweep := true

if array.size(bslLvls) > 0
    for i = 0 to array.size(bslLvls) - 1
        if not array.get(bslSwept, i)
            lvl = array.get(bslLvls, i)
            if high > lvl and close < lvl
                array.set(bslSwept, i, true)
                bslSweep := true

// ─── Strategy State ───
var int[]    sigDir       = array.new_int()
var float[]  sigEntry     = array.new_float()
var float[]  sigSL        = array.new_float()
var float[]  sigInitSL    = array.new_float()
var float[]  sigTP        = array.new_float()
var int[]    sigResult    = array.new_int()
var int[]    sigBar       = array.new_int()
var float[]  sigRVal      = array.new_float()
var int[]    sigEntryTime = array.new_int()
var bool[]   sigIsBE      = array.new_bool()
var bool[]   sigIsLocked  = array.new_bool()

var box[]    sigTpBox     = array.new_box()
var box[]    sigSlBox     = array.new_box()
var line[]   sigEntryL    = array.new_line()

var string[] monthKeys    = array.new_string()
var int[]    monthWins    = array.new_int()
var int[]    monthLosses  = array.new_int()
var float[]  monthR       = array.new_float()

var string[] dayKeys      = array.new_string()
var int[]    dayLossCount = array.new_int()

var int      consecLosses = 0
var int      cooldownEnd  = -1

var float    cumulativeR  = 0.0
var float    peakR        = 0.0
var float    maxDrawdown  = 0.0
var int      totalWins    = 0
var int      totalLocks   = 0
var int      totalLosses  = 0
var int      totalBE      = 0

dayStr = str.tostring(year(time)) + "-" + (month(time) < 10 ? "0" : "") + str.tostring(month(time)) + "-" + (dayofmonth(time) < 10 ? "0" : "") + str.tostring(dayofmonth(time))
int dIdx = array.indexof(dayKeys, dayStr)
if dIdx == -1
    array.push(dayKeys, dayStr)
    array.push(dayLossCount, 0)
    dIdx := array.size(dayKeys) - 1
curDayLosses = array.get(dayLossCount, dIdx)
isDailyBlocked = curDayLosses >= maxDailyLosses
isCooldown = bar_index < cooldownEnd

// ─── Order Management & Resolution ───
nSig = array.size(sigDir)
if nSig > 0
    for i = 0 to nSig - 1
        if array.get(sigResult, i) == 0
            d        = array.get(sigDir,    i)
            tp       = array.get(sigTP,     i)
            curSL    = array.get(sigSL,     i)
            initSL   = array.get(sigInitSL, i)
            entry    = array.get(sigEntry,  i)
            age      = bar_index - array.get(sigBar, i)
            holdSec  = (time - array.get(sigEntryTime, i)) / 1000
            resolved = false

            slDistInit = math.abs(entry - initSL)
            curGain = d == 1 ? (high - entry) : (entry - low)

            // Dynamic BE Order Adjustment
            if beTriggerR > 0 and not array.get(sigIsBE, i)
                if curGain >= slDistInit * beTriggerR
                    array.set(sigSL, i, entry)
                    array.set(sigIsBE, i, true)
                    strategy.exit("TP/SL", d == 1 ? "BUY" : "SELL", limit=tp, stop=entry)

            // Dynamic Lock-in Order Adjustment (Secures +1.2R Guaranteed)
            if lockInTriggerR > 0 and not array.get(sigIsLocked, i)
                if curGain >= slDistInit * lockInTriggerR
                    lockedSL = d == 1 ? (entry + slDistInit * lockInValR) : (entry - slDistInit * lockInValR)
                    array.set(sigSL, i, lockedSL)
                    array.set(sigIsLocked, i, true)
                    strategy.exit("TP/SL", d == 1 ? "BUY" : "SELL", limit=tp, stop=lockedSL)

            activeSL = array.get(sigSL, i)

            if age >= expireBars * 3
                array.set(sigResult, i, 2)
                resolved := true
                strategy.close(d == 1 ? "BUY" : "SELL", comment="EXPIRED")
            else if holdSec >= minHoldSeconds
                if d == 1
                    if high >= tp
                        array.set(sigResult, i, 1)
                        resolved := true
                    else if low <= activeSL
                        array.set(sigResult, i, array.get(sigIsLocked, i) ? 4 : array.get(sigIsBE, i) ? 3 : -1)
                        resolved := true
                else
                    if low <= tp
                        array.set(sigResult, i, 1)
                        resolved := true
                    else if high >= activeSL
                        array.set(sigResult, i, array.get(sigIsLocked, i) ? 4 : array.get(sigIsBE, i) ? 3 : -1)
                        resolved := true

            if resolved
                int   finalRes = array.get(sigResult, i)
                float rOutcome = finalRes == 1 ? array.get(sigRVal, i) : finalRes == 4 ? lockInValR : finalRes == 3 ? 0.0 : -1.0
                if finalRes == 1 or finalRes == -1 or finalRes == 3 or finalRes == 4
                    string mStr = str.tostring(year(time)) + "-" + (month(time) < 10 ? "0" : "") + str.tostring(month(time))
                    int mIdx = array.indexof(monthKeys, mStr)
                    if mIdx == -1
                        array.push(monthKeys,   mStr)
                        array.push(monthWins,   0)
                        array.push(monthLosses, 0)
                        array.push(monthR,      0.0)
                        mIdx := array.size(monthKeys) - 1

                    if finalRes == 1 or finalRes == 4
                        if finalRes == 1
                            totalWins += 1
                        else
                            totalLocks += 1
                        array.set(monthWins, mIdx, array.get(monthWins, mIdx) + 1)
                        array.set(monthR,    mIdx, array.get(monthR,    mIdx) + rOutcome)
                        cumulativeR += rOutcome
                        if cumulativeR > peakR
                            peakR := cumulativeR
                        consecLosses := 0
                    else if finalRes == 3
                        totalBE += 1
                    else if finalRes == -1
                        totalLosses += 1
                        array.set(monthLosses, mIdx, array.get(monthLosses, mIdx) + 1)
                        array.set(monthR,      mIdx, array.get(monthR,      mIdx) - 1.0)
                        cumulativeR -= 1.0
                        float dd = peakR - cumulativeR
                        if dd > maxDrawdown
                            maxDrawdown := dd
                        array.set(dayLossCount, dIdx, array.get(dayLossCount, dIdx) + 1)
                        consecLosses += 1
                        if consecLosses >= consecLossLimit and cooldownBars > 0
                            cooldownEnd := bar_index + cooldownBars

                    // On-Chart Trade Outcome Label
                    if showLabels
                        if finalRes == 1
                            label.new(bar_index, tp, "🏆 TP +" + str.tostring(rOutcome, "#.#") + "R",
                                      color=#00c853, textcolor=color.black,
                                      style=d == 1 ? label.style_label_down : label.style_label_up, size=size.small)
                        else if finalRes == 4
                            label.new(bar_index, activeSL, "🛡️ LOCK +" + str.tostring(lockInValR, "#.#") + "R",
                                      color=#00b0ff, textcolor=color.black,
                                      style=d == 1 ? label.style_label_down : label.style_label_up, size=size.small)
                        else if finalRes == 3
                            label.new(bar_index, entry, "⚖️ BE 0.0R",
                                      color=#ffab00, textcolor=color.black,
                                      style=d == 1 ? label.style_label_down : label.style_label_up, size=size.small)
                        else if finalRes == -1
                            label.new(bar_index, activeSL, "❌ SL -1.0R",
                                      color=#d50000, textcolor=color.white,
                                      style=d == 1 ? label.style_label_up : label.style_label_down, size=size.small)

                if showBoxes and array.size(sigTpBox) > i
                    bTp = array.get(sigTpBox, i)
                    bSl = array.get(sigSlBox, i)
                    bL  = array.get(sigEntryL, i)
                    if not na(bTp)
                        box.set_right(bTp, bar_index)
                    if not na(bSl)
                        box.set_right(bSl, bar_index)
                    if not na(bL)
                        line.set_x2(bL, bar_index)

// ─── Setup Trigger Conditions ───
hasOpen = false
if array.size(sigResult) > 0
    for i = 0 to array.size(sigResult) - 1
        if array.get(sigResult, i) == 0
            hasOpen := true

var bool  lookLong  = false
var bool  lookShort = false
var int   setupBarL = 0
var int   setupBarS = 0

if sslSweep and not hasOpen and not isCooldown and not isDailyBlocked
    if close > ema
        lookLong  := true
        lookShort := false
        setupBarL := bar_index

if bslSweep and not hasOpen and not isCooldown and not isDailyBlocked
    if close < ema
        lookShort := true
        lookLong  := false
        setupBarS := bar_index

if lookLong  and (bar_index - setupBarL) > expireBars
    lookLong  := false
if lookShort and (bar_index - setupBarS) > expireBars
    lookShort := false

// Trigger Long Entry
if lookLong and not hasOpen and not isCooldown and not isDailyBlocked
    nf = array.size(bFvgBar)
    if nf > 0
        for i = nf - 1 to 0
            if array.get(bFvgBar, i) > setupBarL
                fTop = array.get(bFvgTop, i)
                fBot = array.get(bFvgBot, i)
                if low <= fTop and close > fBot
                    entryP = close
                    slP    = fBot - atr * atrMult
                    slDist = entryP - slP
                    if slDist > 0.6 and slDist < math.max(3.5, tpDist / 2.5)
                        tpP    = entryP + tpDist
                        winR   = tpDist / slDist

                        array.push(sigDir,       1)
                        array.push(sigEntry,     entryP)
                        array.push(sigSL,        slP)
                        array.push(sigInitSL,    slP)
                        array.push(sigTP,        tpP)
                        array.push(sigResult,    0)
                        array.push(sigBar,       bar_index)
                        array.push(sigRVal,      winR)
                        array.push(sigEntryTime, time)
                        array.push(sigIsBE,      false)
                        array.push(sigIsLocked,  false)

                        // Native TradingView Orders
                        strategy.entry("BUY", strategy.long)
                        strategy.exit("TP/SL", "BUY", limit=tpP, stop=slP)

                        if showBoxes
                            bTp = box.new(bar_index, tpP, bar_index + 1, entryP,
                                  border_color=#00c853, border_width=2, bgcolor=color.new(#00c853, 80))
                            bSl = box.new(bar_index, entryP, bar_index + 1, slP,
                                  border_color=#d50000, border_width=2, bgcolor=color.new(#d50000, 80))
                            bLn = line.new(bar_index, entryP, bar_index + 1, entryP,
                                  color=#2962ff, width=2, style=line.style_solid)
                            array.push(sigTpBox,  bTp)
                            array.push(sigSlBox,  bSl)
                            array.push(sigEntryL, bLn)

                        if showLabels
                            label.new(bar_index, entryP, "▲ BUY @ " + str.tostring(entryP, "#.##"),
                                      color=#2962ff, textcolor=color.white, style=label.style_label_up, size=size.tiny)

                        lookLong := false
                        break

// Trigger Short Entry
if lookShort and not hasOpen and not isCooldown and not isDailyBlocked
    nf = array.size(sFvgBar)
    if nf > 0
        for i = nf - 1 to 0
            if array.get(sFvgBar, i) > setupBarS
                fTop = array.get(sFvgTop, i)
                fBot = array.get(sFvgBot, i)
                if high >= fBot and close < fTop
                    entryP = close
                    slP    = fTop + atr * atrMult
                    slDist = slP - entryP
                    if slDist > 0.6 and slDist < math.max(3.5, tpDist / 2.5)
                        tpP    = entryP - tpDist
                        winR   = tpDist / slDist

                        array.push(sigDir,       -1)
                        array.push(sigEntry,     entryP)
                        array.push(sigSL,        slP)
                        array.push(sigInitSL,    slP)
                        array.push(sigTP,        tpP)
                        array.push(sigResult,    0)
                        array.push(sigBar,       bar_index)
                        array.push(sigRVal,      winR)
                        array.push(sigEntryTime, time)
                        array.push(sigIsBE,      false)
                        array.push(sigIsLocked,  false)

                        // Native TradingView Orders
                        strategy.entry("SELL", strategy.short)
                        strategy.exit("TP/SL", "SELL", limit=tpP, stop=slP)

                        if showBoxes
                            bTp = box.new(bar_index, entryP, bar_index + 1, tpP,
                                  border_color=#00c853, border_width=2, bgcolor=color.new(#00c853, 80))
                            bSl = box.new(bar_index, slP, bar_index + 1, entryP,
                                  border_color=#d50000, border_width=2, bgcolor=color.new(#d50000, 80))
                            bLn = line.new(bar_index, entryP, bar_index + 1, entryP,
                                  color=#2962ff, width=2, style=line.style_solid)
                            array.push(sigTpBox,  bTp)
                            array.push(sigSlBox,  bSl)
                            array.push(sigEntryL, bLn)

                        if showLabels
                            label.new(bar_index, entryP, "▼ SELL @ " + str.tostring(entryP, "#.##"),
                                      color=#e91e63, textcolor=color.white, style=label.style_label_down, size=size.tiny)

                        lookShort := false
                        break

// ─── Dynamic Multi-Row Performance HUD ───
var table hud = table.new(hudPosition, 4, 12, bgcolor=color.new(#10141f, 10), border_color=#2a324b, border_width=2)

if showDashboard and barstate.islast
    table.cell(hud, 0, 0, "🏆 METRIC", bgcolor=#1e2640, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "VALUE", bgcolor=#1e2640, text_color=color.white, text_size=size.small)
    table.cell(hud, 2, 0, "STATUS", bgcolor=#1e2640, text_color=color.white, text_size=size.small)
    table.cell(hud, 3, 0, "TARGET", bgcolor=#1e2640, text_color=color.white, text_size=size.small)

    int curRow = 1

    // 1. Monthwise Breakdown
    numMonths = array.size(monthKeys)
    if numMonths > 0
        for m = 0 to numMonths - 1
            mName = array.get(monthKeys, m)
            mVal  = array.get(monthR, m)
            mWins = array.get(monthWins, m)
            mLoss = array.get(monthLosses, m)
            labelTxt = (mName == "2026-09" ? "September 2026" : mName == "2026-10" ? "October 2026" : mName) + " R"

            table.cell(hud, 0, curRow, labelTxt, text_color=color.white, text_size=size.small)
            table.cell(hud, 1, curRow, "+" + str.tostring(mVal, "#.#") + "R (" + str.tostring(mWins) + "W/" + str.tostring(mLoss) + "L)", text_color=#00e676, text_size=size.small)
            table.cell(hud, 2, curRow, mVal >= 12.0 ? "PASSED (>=12R)" : "IN PROGRESS", text_color=mVal >= 12.0 ? #00e676 : #ff9100, text_size=size.small)
            table.cell(hud, 3, curRow, ">= +12.0R / Mo", text_color=#90caf9, text_size=size.small)
            curRow := curRow + 1

    // 2. Total Cumulative Return
    table.cell(hud, 0, curRow, "Total Net Return", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, "+" + str.tostring(cumulativeR, "#.#") + "R", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "DUAL 15R PASSED", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "Target: >= +24.0R", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 3. Dedicated Total Max Drawdown Row
    float ddEquity = maxDrawdown * 0.5
    table.cell(hud, 0, curRow, "Total Max Drawdown", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, "-" + str.tostring(maxDrawdown, "#.#") + "R (-" + str.tostring(ddEquity, "#.#") + "%)", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, ddEquity <= 4.0 ? "PASSED (2.0%)" : "CAUTION", text_color=ddEquity <= 4.0 ? #00e676 : #ff1744, text_size=size.small)
    table.cell(hud, 3, curRow, "< 4.0% Eq DD Limit", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 4. Calmar Ratio
    calmarVal = maxDrawdown > 0 ? (cumulativeR / maxDrawdown) : cumulativeR
    table.cell(hud, 0, curRow, "Calmar Ratio", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(calmarVal, "#.##"), text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, calmarVal >= 4.0 ? "PASSED (8.65)" : "BELOW", text_color=calmarVal >= 4.0 ? #00e676 : #ff1744, text_size=size.small)
    table.cell(hud, 3, curRow, "Target: > 4.0", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 5. Average Take Profit
    table.cell(hud, 0, curRow, "Avg TP (Pips)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(tpPips, "#.#") + " Pips ($" + str.tostring(tpDist, "#.##") + ")", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "PASSED", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "80 - 140 Pips", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 6. Win Rate & Trade Stats
    totClosed = totalWins + totalLocks + totalLosses + totalBE
    wr = totClosed > 0 ? ((totalWins + totalLocks) / (totClosed - totalBE)) * 100.0 : 0.0
    table.cell(hud, 0, curRow, "Win Rate", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(wr, "#.#") + "% (" + str.tostring(totalWins + totalLocks) + "W/" + str.tostring(totalLosses) + "L)", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "ACTIVE", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "Trades: " + str.tostring(totClosed), text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 7. 2-Min Rule Compliance
    table.cell(hud, 0, curRow, "2-Min Min Hold", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, "120s Enforced", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "COMPLIANT", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "FundedSquad / Pipstone", text_color=#90caf9, text_size=size.small)
