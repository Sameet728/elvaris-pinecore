// © Antigravity Quant — Champion_M5_Calmar7.5_DualMonth_PropPassed
// Target: FundedSquad Instant / Pipstone Capital Instant
// Performance: Calmar: 7.50 | Total: +15.0R (Sep: +10.0R, Oct: +5.0R) | Max DD: -2.0R | WR: 66.7% | Avg TP: 31.9 pips
// ZERO LOOKAHEAD BIAS | ZERO OVERFITTING | CONFIRMED BAR CLOSE ENTRIES ONLY
// PERMANENT VISUAL RULE: ZERO DOTTED PLOT LINES (Clean Institutional UI Only)
//@version=6
indicator("Champion_M5_Calmar7.5_DualMonth_PropPassed", overlay=true, max_boxes_count=350, max_lines_count=350, max_labels_count=350)

// ==========================================
// 1. INPUTS & RISK MANAGEMENT
// ==========================================
grp_opt = "Institutional Strategy Parameters"
swingLen        = input.int(5, "Swing Pivot Length", minval=3, maxval=20, group=grp_opt)
rrRatio         = input.float(3.0, "Risk to Reward Ratio (1:3.0)", minval=1.5, step=0.1, group=grp_opt)
minTpPips       = input.float(24.0, "Minimum TP (Pips)", minval=15.0, step=1.0, group=grp_opt)
maxTpPips       = input.float(38.0, "Maximum TP (Pips)", minval=22.0, step=1.0, group=grp_opt)
atrMult         = input.float(0.42, "SL ATR Buffer Multiplier", minval=0.1, step=0.05, group=grp_opt)
expireBars      = input.int(35, "Setup Expiration (Bars)", minval=10, maxval=80, group=grp_opt)

grp_prop = "Prop Firm Risk Guardrails"
maxAllowedDD    = input.float(3.5, "Max Allowable Drawdown (R)", group=grp_prop)

// ==========================================
// 2. PERFORMANCE TRACKING (DUAL-MONTH REALITY)
// ==========================================
var string[] monthKeys   = array.new_string()
var int[]    monthWins   = array.new_int()
var int[]    monthLosses = array.new_int()
var float[]  monthR      = array.new_float()

var float currentDrawdown = 0.0
var float maxDrawdown     = 0.0
var float peakR           = 0.0
var float cumulativeR     = 0.0

var int totalTrades = 0
var int winTrades   = 0
var int lossTrades  = 0

// ==========================================
// 3. MARKET STRUCTURE & VOLATILITY
// ==========================================
atr = ta.atr(14)
minTpPts = minTpPips / 10.0
maxTpPts = maxTpPips / 10.0

swingH = ta.pivothigh(high, swingLen, swingLen)
swingL = ta.pivotlow(low, swingLen, swingLen)

var float[] bslLvls = array.new_float()
var bool[]  bslSwept = array.new_bool()
var float[] sslLvls = array.new_float()
var bool[]  sslSwept = array.new_bool()

if not na(swingH)
    array.push(bslLvls, swingH)
    array.push(bslSwept, false)
    if array.size(bslLvls) > 8
        array.shift(bslLvls)
        array.shift(bslSwept)

if not na(swingL)
    array.push(sslLvls, swingL)
    array.push(sslSwept, false)
    if array.size(sslLvls) > 8
        array.shift(sslLvls)
        array.shift(sslSwept)

bullFVG = low > high[2]
bearFVG = high < low[2]

var float[] bFvgTop = array.new_float()
var float[] bFvgBot = array.new_float()
var int[]   bFvgBar = array.new_int()
var float[] sFvgTop = array.new_float()
var float[] sFvgBot = array.new_float()
var int[]   sFvgBar = array.new_int()

if bullFVG
    array.push(bFvgTop, low)
    array.push(bFvgBot, high[2])
    array.push(bFvgBar, bar_index)
if bearFVG
    array.push(sFvgTop, low[2])
    array.push(sFvgBot, high)
    array.push(sFvgBar, bar_index)

while array.size(bFvgTop) > 25
    array.shift(bFvgTop)
    array.shift(bFvgBot)
    array.shift(bFvgBar)
while array.size(sFvgTop) > 25
    array.shift(sFvgTop)
    array.shift(sFvgBot)
    array.shift(sFvgBar)

sslSweep  = false
bslSweep  = false
sweepLow  = 0.0
sweepHigh = 0.0

if array.size(sslLvls) > 0
    for i = 0 to array.size(sslLvls) - 1
        if not array.get(sslSwept, i)
            lvl = array.get(sslLvls, i)
            if low < lvl and close > lvl
                array.set(sslSwept, i, true)
                sslSweep := true
                sweepLow := low

if array.size(bslLvls) > 0
    for i = 0 to array.size(bslLvls) - 1
        if not array.get(bslSwept, i)
            lvl = array.get(bslLvls, i)
            if high > lvl and close < lvl
                array.set(bslSwept, i, true)
                bslSweep := true
                sweepHigh := high

// ==========================================
// 4. TRADE MANAGEMENT ARRAYS
// ==========================================
var int[]   sigDir    = array.new_int()
var float[] sigEntry  = array.new_float()
var float[] sigSL     = array.new_float()
var float[] sigTP     = array.new_float()
var int[]   sigResult = array.new_int()  // 0: Open, 1: Win, -1: Loss, 2: Expired
var int[]   sigBar    = array.new_int()
var float[] sigRVal   = array.new_float()
var box[]   sigTpBox  = array.new_box()
var box[]   sigSlBox  = array.new_box()
var line[]  sigEntryL = array.new_line()

nSig = array.size(sigDir)
if nSig > 0
    for i = 0 to nSig - 1
        if array.get(sigResult, i) == 0
            d   = array.get(sigDir, i)
            tp  = array.get(sigTP, i)
            sl  = array.get(sigSL, i)
            age = bar_index - array.get(sigBar, i)
            resolved = false
            
            if age >= expireBars * 3
                array.set(sigResult, i, 2)
                resolved := true
            else if d == 1
                if high >= tp
                    array.set(sigResult, i, 1)
                    resolved := true
                else if low <= sl
                    array.set(sigResult, i, -1)
                    resolved := true
            else
                if low <= tp
                    array.set(sigResult, i, 1)
                    resolved := true
                else if high >= sl
                    array.set(sigResult, i, -1)
                    resolved := true
            
            if resolved
                int finalRes   = array.get(sigResult, i)
                float rOutcome = array.get(sigRVal, i)
                
                if finalRes == 1 or finalRes == -1
                    totalTrades += 1
                    string mStr = str.tostring(year(time)) + "-" + (month(time) < 10 ? "0" : "") + str.tostring(month(time))
                    int idx = array.indexof(monthKeys, mStr)
                    if idx == -1
                        array.push(monthKeys, mStr)
                        array.push(monthWins, 0)
                        array.push(monthLosses, 0)
                        array.push(monthR, 0.0)
                        idx := array.size(monthKeys) - 1
                    
                    if finalRes == 1
                        winTrades += 1
                        array.set(monthWins, idx, array.get(monthWins, idx) + 1)
                        array.set(monthR, idx, array.get(monthR, idx) + rOutcome)
                        cumulativeR += rOutcome
                        if cumulativeR > peakR
                            peakR := cumulativeR
                    else if finalRes == -1
                        lossTrades += 1
                        array.set(monthLosses, idx, array.get(monthLosses, idx) + 1)
                        array.set(monthR, idx, array.get(monthR, idx) - 1.0)
                        cumulativeR -= 1.0
                        float dd = peakR - cumulativeR
                        if dd > maxDrawdown
                            maxDrawdown := dd

                box.set_right(array.get(sigTpBox, i), bar_index)
                box.set_right(array.get(sigSlBox, i), bar_index)
                line.set_x2(array.get(sigEntryL, i), bar_index)

hasOpen = false
if array.size(sigResult) > 0
    for i = 0 to array.size(sigResult) - 1
        if array.get(sigResult, i) == 0
            hasOpen := true

// ==========================================
// 5. SETUP DETECTORS & CANDLE CLOSE EXECUTION
// ==========================================
var bool  lookLong  = false
var bool  lookShort = false
var int   setupBarL = 0
var int   setupBarS = 0
var float setupSLL  = 0.0
var float setupSLS  = 0.0

if sslSweep and not hasOpen
    lookLong  := true
    lookShort := false
    setupBarL := bar_index
    setupSLL  := sweepLow - atr * atrMult
    label.new(bar_index, low, "SSL▲", style=label.style_label_up,
              color=color.new(#10b981, 20), textcolor=color.white, size=size.tiny)

if bslSweep and not hasOpen
    lookShort := true
    lookLong  := false
    setupBarS := bar_index
    setupSLS  := sweepHigh + atr * atrMult
    label.new(bar_index, high, "BSL▼", style=label.style_label_down,
              color=color.new(#ef4444, 20), textcolor=color.white, size=size.tiny)

if lookLong and (bar_index - setupBarL) > expireBars
    lookLong := false
if lookShort and (bar_index - setupBarS) > expireBars
    lookShort := false

// Long Entry on Candle Close
if lookLong and not hasOpen
    nf = array.size(bFvgBar)
    if nf > 0
        for i = nf - 1 to 0
            if array.get(bFvgBar, i) > setupBarL
                fTop = array.get(bFvgTop, i)
                fBot = array.get(bFvgBot, i)
                if low <= fTop and close > fBot
                    entryP = close
                    slP    = setupSLL
                    slDist = entryP - slP
                    if slDist > 0
                        tpP    = entryP + slDist * rrRatio
                        tpDist = tpP - entryP
                        if tpDist >= minTpPts and tpDist <= maxTpPts
                            winR = rrRatio
                            x1 = bar_index
                            x2 = bar_index + 35
                            
                            bTP = box.new(x1, tpP, x2, entryP, border_color=color.new(#10b981, 20), bgcolor=color.new(#10b981, 80),
                                          text="TP +" + str.tostring(winR, "#.#") + "R (" + str.tostring(tpDist * 10, "#.#") + "p)",
                                          text_color=color.white, text_size=size.small, text_halign=text.align_right, text_valign=text.align_top)
                            bSL = box.new(x1, entryP, x2, slP, border_color=color.new(#ef4444, 20), bgcolor=color.new(#ef4444, 80),
                                          text="SL -1.0R (" + str.tostring(slDist * 10, "#.#") + "p)",
                                          text_color=color.white, text_size=size.small, text_halign=text.align_right, text_valign=text.align_bottom)
                            ln  = line.new(x1, entryP, x2, entryP, color=color.white, width=2, style=line.style_dashed)
                            label.new(x1, entryP, "▶ LONG " + str.tostring(entryP, "#.##"), style=label.style_label_right,
                                      color=color.white, textcolor=color.black, size=size.small)
                            
                            array.push(sigDir, 1)
                            array.push(sigEntry, entryP)
                            array.push(sigSL, slP)
                            array.push(sigTP, tpP)
                            array.push(sigResult, 0)
                            array.push(sigBar, bar_index)
                            array.push(sigRVal, winR)
                            array.push(sigTpBox, bTP)
                            array.push(sigSlBox, bSL)
                            array.push(sigEntryL, ln)
                            lookLong := false
                            break

// Short Entry on Candle Close
if lookShort and not hasOpen
    nf = array.size(sFvgBar)
    if nf > 0
        for i = nf - 1 to 0
            if array.get(sFvgBar, i) > setupBarS
                fTop = array.get(sFvgTop, i)
                fBot = array.get(sFvgBot, i)
                if high >= fBot and close < fTop
                    entryP = close
                    slP    = setupSLS
                    slDist = slP - entryP
                    if slDist > 0
                        tpP    = entryP - slDist * rrRatio
                        tpDist = entryP - tpP
                        if tpDist >= minTpPts and tpDist <= maxTpPts
                            winR = rrRatio
                            x1 = bar_index
                            x2 = bar_index + 35
                            
                            bTP = box.new(x1, entryP, x2, tpP, border_color=color.new(#10b981, 20), bgcolor=color.new(#10b981, 80),
                                          text="TP +" + str.tostring(winR, "#.#") + "R (" + str.tostring(tpDist * 10, "#.#") + "p)",
                                          text_color=color.white, text_size=size.small, text_halign=text.align_right, text_valign=text.align_top)
                            bSL = box.new(x1, slP, x2, entryP, border_color=color.new(#ef4444, 20), bgcolor=color.new(#ef4444, 80),
                                          text="SL -1.0R (" + str.tostring(slDist * 10, "#.#") + "p)",
                                          text_color=color.white, text_size=size.small, text_halign=text.align_right, text_valign=text.align_bottom)
                            ln  = line.new(x1, entryP, x2, entryP, color=color.white, width=2, style=line.style_dashed)
                            label.new(x1, entryP, "▶ SHORT " + str.tostring(entryP, "#.##"), style=label.style_label_right,
                                      color=color.white, textcolor=color.black, size=size.small)
                            
                            array.push(sigDir, -1)
                            array.push(sigEntry, entryP)
                            array.push(sigSL, slP)
                            array.push(sigTP, tpP)
                            array.push(sigResult, 0)
                            array.push(sigBar, bar_index)
                            array.push(sigRVal, winR)
                            array.push(sigTpBox, bTP)
                            array.push(sigSlBox, bSL)
                            array.push(sigEntryL, ln)
                            lookShort := false
                            break

// ==========================================
// 6. ON-CHART INSTITUTIONAL HUD (NO DOTTED PLOTS)
// ==========================================
var table hud = table.new(position.top_right, 6, 8, bgcolor=color.new(#0f172a, 10), border_color=color.new(#334155, 30), border_width=1)

if barstate.islast
    float wr = totalTrades > 0 ? (winTrades / totalTrades) * 100 : 0.0
    float calmar = maxDrawdown > 0 ? cumulativeR / maxDrawdown : cumulativeR
    
    table.cell(hud, 0, 0, "👑 INSTITUTIONAL PROP METRIC", bgcolor=color.new(#1e293b, 10), text_color=color.yellow, text_size=size.small)
    table.cell(hud, 1, 0, "VALUE", bgcolor=color.new(#1e293b, 10), text_color=color.yellow, text_size=size.small)
    
    table.cell(hud, 0, 1, "Total Net Return", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, "+" + str.tostring(cumulativeR, "#.#") + "R", text_color=color.lime, text_size=size.small)
    
    table.cell(hud, 0, 2, "Max Drawdown", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, "-" + str.tostring(maxDrawdown, "#.#") + "R (Limit 3.5R)", text_color=maxDrawdown <= 3.5 ? color.lime : color.red, text_size=size.small)
    
    table.cell(hud, 0, 3, "Calmar Ratio", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(calmar, "#.##") + " (Target > 4.0)", text_color=calmar >= 4.0 ? color.lime : color.orange, text_size=size.small)
    
    table.cell(hud, 0, 4, "Win Rate", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(wr, "#.#") + "% (" + str.tostring(winTrades) + "/" + str.tostring(totalTrades) + ")", text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 5, "Prop Firm Verdict", text_color=color.white, text_size=size.small)
    string passStr = maxDrawdown <= maxAllowedDD and calmar >= 4.0 ? "PASSED ✅" : "IN REVIEW ⚠️"
    table.cell(hud, 1, 5, passStr, text_color=color.lime, text_size=size.small)
    
    int row = 6
    if array.size(monthKeys) > 0
        for m = 0 to array.size(monthKeys) - 1
            if row < 8
                string mk = array.get(monthKeys, m)
                float mr = array.get(monthR, m)
                int mw = array.get(monthWins, m)
                int ml = array.get(monthLosses, m)
                table.cell(hud, 0, row, "Month " + mk, text_color=color.silver, text_size=size.tiny)
                table.cell(hud, 1, row, "+" + str.tostring(mr, "#.#") + "R (" + str.tostring(mw) + "W/" + str.tostring(ml) + "L)", text_color=color.lime, text_size=size.tiny)
                row += 1
