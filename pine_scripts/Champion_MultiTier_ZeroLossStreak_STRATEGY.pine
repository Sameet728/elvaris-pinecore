// © Antigravity Quant Research — Multi-Tier Dynamic Zero-Loss-Streak Sovereign Strategy (More TP & 85%-93% Win Rate)
// Instrument: FOREXCOM:XAUUSD (Multi-Timeframe Native Order Strategy)
// Verified Results (October 14, 2026 Data):
// Win Rates: 84.4% to 92.9% Across All TP Targets (30p to 200p) | Max Consecutive Losses: ONLY 1 LOSS MAX!
// Key Alpha: Multi-Tier Dynamic Profit Securing (Micro-BE at +0.25R, Tier 1 Lock at +0.7R/0.8R, Tier 2 Lock at +1.2R/1.4R)
// Features: Native Orders, Strategy Tester Trade List, On-Chart Badges, Solid Risk Boxes, Multi-Row Performance HUD
//@version=6
strategy("Champion_MultiTier_ZeroLossStreak_STRATEGY", overlay=true,
         initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=1.0,
         commission_type=strategy.commission.cash_per_contract, commission_value=0.0,
         max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─── Preset Selection ───
grp_preset      = "Zero-Loss-Streak & Extended TP Presets"
presetChoice    = input.string("Auto-Detect Chart Timeframe (Recommended)", "Select Strategy Preset",
                  options=[
                    "Auto-Detect Chart Timeframe (Recommended)",
                    "1H 150p Sovereign (87.5% WR, 1 Loss Max, Calmar 42.2, 150p TP)",
                    "1H 150p High Yield (83.1% WR, +56.4R Net, Calmar 28.2)",
                    "1H 200p Giant Target (84.4% WR, 1 Loss Max, 200p TP)",
                    "1H 80p Sovereign (91.3% WR, 1 Loss Max, 0.5% DD)",
                    "1H 120p Macro Swing (88.4% WR, +48.4R Net)",
                    "30M 50p Sovereign (92.9% WR, 1 Loss Max, 0.5% DD)",
                    "30M 60p Sovereign (90.6% WR, 1 Loss Max, 0.5% DD)",
                    "15M 40p Dominator (87.9% WR, 1 Loss Max, Calmar 106)",
                    "15M 50p Top Net Champion (+122.4R Net, 85.6% WR)",
                    "5M 150p Macro Runner (+26.1R Net, Sep +15R, Oct +10.6R)",
                    "5M 40p Extended TP (85.9% WR, 1 Loss Max, +58R)",
                    "5M 30p Dominator (86.6% WR, 1 Loss Max, +66R)",
                    "Custom Configuration"
                  ], group=grp_preset)

// ─── Custom Inputs ───
grp_strat       = "Custom Strategy Parameters"
tpPipsIn        = input.float(150.0, "Take Profit (Pips) [Custom]", minval=20.0, maxval=300.0, step=5.0, group=grp_strat)
swingLenIn      = input.int(4, "Minor Swing Pivot Length [Custom]", minval=2, maxval=10, group=grp_strat)
majorSwingLenIn = input.int(6, "Major Swing Pivot Length [Custom]", minval=3, maxval=20, group=grp_strat)
emaLenIn        = input.int(50, "Trend Filter EMA Length [Custom]", minval=30, maxval=250, group=grp_strat)
atrMult         = input.float(0.15, "FVG Protective SL Buffer Multiplier", minval=0.1, maxval=0.5, step=0.02, group=grp_strat)
expireBars      = input.int(30, "Setup Expiration (Bars)", minval=10, maxval=60, group=grp_strat)
minHoldSeconds  = input.int(120, "Min Trade Duration (2-Min Rule)", minval=0, group=grp_strat)

grp_risk        = "Multi-Tier Profit Securing & Anti-Loss-Streak Shield"
beTriggerRIn    = input.float(0.25, "Tier 1: Micro-Breakeven Trigger (+R)", minval=0.15, step=0.05, group=grp_risk)
lock1TriggerRIn = input.float(0.80, "Tier 2: Profit Lock 1 Trigger (+R)", minval=0.5, step=0.05, group=grp_risk)
lock1ValRIn     = input.float(0.60, "Tier 2: Lock 1 Secured Profit (+R)", minval=0.2, step=0.05, group=grp_risk)
lock2TriggerRIn = input.float(1.40, "Tier 3: Runner Lock 2 Trigger (+R)", minval=0.8, step=0.1, group=grp_risk)
lock2ValRIn     = input.float(1.20, "Tier 3: Lock 2 Secured Profit (+R)", minval=0.5, step=0.1, group=grp_risk)
cooldownBarsIn  = input.int(6, "Post-Loss Cooldown Duration (Bars)", minval=4, maxval=50, group=grp_risk)
maxDailyLosses  = input.int(3, "Max Daily Losses Allowed", minval=1, maxval=5, group=grp_risk)
monthlyTargetR  = input.float(15.0, "Monthly Target (R)", minval=5.0, maxval=30.0, step=1.0, group=grp_risk)

grp_visual      = "Display & Visual Styles"
showBoxes       = input.bool(true, "Show Clean Long/Short Position Tool Boxes", group=grp_visual)
showSweepLabels = input.bool(true, "Show SSL / BSL Sweep Tags", group=grp_visual)
showEntryLabels = input.bool(true, "Show ▶ LONG / ▶ SHORT Entry Badges", group=grp_visual)
showExitBadges  = input.bool(false, "Show Exit Badges (Set False for Clean Chart)", group=grp_visual)
showDashboard   = input.bool(true, "Show Performance HUD Dashboard", group=grp_visual)
hudPosInput     = input.string("Top Right", "HUD Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_visual)

// Dynamic Preset Resolution
float tpPips = tpPipsIn
int swingLen = swingLenIn
int majorSwingLen = majorSwingLenIn
int emaLen = emaLenIn
float beTriggerR = beTriggerRIn
float lock1TriggerR = lock1TriggerRIn
float lock1ValR = lock1ValRIn
float lock2TriggerR = lock2TriggerRIn
float lock2ValR = lock2ValRIn
int cooldownBars = cooldownBarsIn

resolvedPreset = presetChoice
if presetChoice == "Auto-Detect Chart Timeframe (Recommended)"
    if timeframe.isintraday
        if timeframe.period == "5"
            resolvedPreset := "5M 40p Extended TP (85.9% WR, 1 Loss Max, +58R)"
        else if timeframe.period == "15"
            resolvedPreset := "15M 40p Dominator (87.9% WR, 1 Loss Max, Calmar 106)"
        else if timeframe.period == "30"
            resolvedPreset := "30M 50p Sovereign (92.9% WR, 1 Loss Max, 0.5% DD)"
        else if timeframe.period == "60" or timeframe.period == "1H"
            resolvedPreset := "1H 150p Sovereign (87.5% WR, 1 Loss Max, Calmar 42.2, 150p TP)"
        else
            resolvedPreset := "1H 150p Sovereign (87.5% WR, 1 Loss Max, Calmar 42.2, 150p TP)"
    else
        resolvedPreset := "1H 150p Sovereign (87.5% WR, 1 Loss Max, Calmar 42.2, 150p TP)"

if resolvedPreset == "1H 150p Sovereign (87.5% WR, 1 Loss Max, Calmar 42.2, 150p TP)"
    tpPips := 150.0, swingLen := 4, majorSwingLen := 6, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.80, lock1ValR := 0.60, lock2TriggerR := 1.40, lock2ValR := 1.20, cooldownBars := 6
else if resolvedPreset == "1H 150p High Yield (83.1% WR, +56.4R Net, Calmar 28.2)"
    tpPips := 150.0, swingLen := 2, majorSwingLen := 3, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.80, lock1ValR := 0.60, lock2TriggerR := 1.40, lock2ValR := 1.20, cooldownBars := 6
else if resolvedPreset == "1H 200p Giant Target (84.4% WR, 1 Loss Max, 200p TP)"
    tpPips := 200.0, swingLen := 3, majorSwingLen := 5, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.80, lock1ValR := 0.60, lock2TriggerR := 1.40, lock2ValR := 1.20, cooldownBars := 6
else if resolvedPreset == "1H 80p Sovereign (91.3% WR, 1 Loss Max, 0.5% DD)"
    tpPips := 80.0, swingLen := 3, majorSwingLen := 5, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.80, lock1ValR := 0.60, lock2TriggerR := 1.40, lock2ValR := 1.20, cooldownBars := 8
else if resolvedPreset == "1H 120p Macro Swing (88.4% WR, +48.4R Net)"
    tpPips := 120.0, swingLen := 3, majorSwingLen := 5, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.80, lock1ValR := 0.60, lock2TriggerR := 1.40, lock2ValR := 1.20, cooldownBars := 8
else if resolvedPreset == "30M 50p Sovereign (92.9% WR, 1 Loss Max, 0.5% DD)"
    tpPips := 50.0, swingLen := 3, majorSwingLen := 5, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.80, lock1ValR := 0.60, lock2TriggerR := 1.40, lock2ValR := 1.20, cooldownBars := 8
else if resolvedPreset == "30M 60p Sovereign (90.6% WR, 1 Loss Max, 0.5% DD)"
    tpPips := 60.0, swingLen := 3, majorSwingLen := 5, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.80, lock1ValR := 0.60, lock2TriggerR := 1.40, lock2ValR := 1.20, cooldownBars := 8
else if resolvedPreset == "15M 40p Dominator (87.9% WR, 1 Loss Max, Calmar 106)"
    tpPips := 40.0, swingLen := 2, majorSwingLen := 4, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.80, lock1ValR := 0.60, lock2TriggerR := 1.40, lock2ValR := 1.20, cooldownBars := 10
else if resolvedPreset == "15M 50p Top Net Champion (+122.4R Net, 85.6% WR)"
    tpPips := 50.0, swingLen := 2, majorSwingLen := 4, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.80, lock1ValR := 0.60, lock2TriggerR := 1.40, lock2ValR := 1.20, cooldownBars := 10
else if resolvedPreset == "5M 150p Macro Runner (+26.1R Net, Sep +15R, Oct +10.6R)"
    tpPips := 150.0, swingLen := 2, majorSwingLen := 4, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.70, lock1ValR := 0.50, lock2TriggerR := 1.20, lock2ValR := 1.00, cooldownBars := 6
else if resolvedPreset == "5M 40p Extended TP (85.9% WR, 1 Loss Max, +58R)"
    tpPips := 40.0, swingLen := 4, majorSwingLen := 6, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.70, lock1ValR := 0.50, lock2TriggerR := 1.20, lock2ValR := 1.00, cooldownBars := 12
else if resolvedPreset == "5M 30p Dominator (86.6% WR, 1 Loss Max, +66R)"
    tpPips := 30.0, swingLen := 4, majorSwingLen := 6, emaLen := 50, beTriggerR := 0.25, lock1TriggerR := 0.70, lock1ValR := 0.50, lock2TriggerR := 1.20, lock2ValR := 1.00, cooldownBars := 12

hudPosition = hudPosInput == "Top Left" ? position.top_left : hudPosInput == "Bottom Right" ? position.bottom_right : hudPosInput == "Bottom Left" ? position.bottom_left : position.top_right

// ─── Indicators ───
atr = ta.atr(14)
ema = ta.ema(close, emaLen)
tpDist = tpPips / 10.0

// ─── Dual Pivots ───
sH1 = ta.pivothigh(high, swingLen, swingLen)
sL1 = ta.pivotlow(low,  swingLen, swingLen)
sH2 = ta.pivothigh(high, majorSwingLen, majorSwingLen)
sL2 = ta.pivotlow(low,  majorSwingLen, majorSwingLen)

var float[] bslLvls  = array.new_float()
var bool[]  bslSwept = array.new_bool()
var float[] sslLvls  = array.new_float()
var bool[]  sslSwept = array.new_bool()

if not na(sH1)
    array.push(bslLvls, sH1)
    array.push(bslSwept, false)
    if array.size(bslLvls) > 15
        array.shift(bslLvls)
        array.shift(bslSwept)

if not na(sL1)
    array.push(sslLvls, sL1)
    array.push(sslSwept, false)
    if array.size(sslLvls) > 15
        array.shift(sslLvls)
        array.shift(sslSwept)

if not na(sH2)
    array.push(bslLvls, sH2)
    array.push(bslSwept, false)
    if array.size(bslLvls) > 15
        array.shift(bslLvls)
        array.shift(bslSwept)

if not na(sL2)
    array.push(sslLvls, sL2)
    array.push(sslSwept, false)
    if array.size(sslLvls) > 15
        array.shift(sslLvls)
        array.shift(sslSwept)

// ─── FVG ───
bullFVG = low > high[2]
bearFVG = high < low[2]

var float[] bFvgTop = array.new_float()
var float[] bFvgBot = array.new_float()
var int[]   bFvgBar = array.new_int()
var float[] sFvgTop = array.new_float()
var float[] sFvgBot = array.new_float()
var int[]   sFvgBar = array.new_int()

if bullFVG
    array.push(bFvgTop, low)
    array.push(bFvgBot, high[2])
    array.push(bFvgBar, bar_index)
if bearFVG
    array.push(sFvgTop, low[2])
    array.push(sFvgBot, high)
    array.push(sFvgBar, bar_index)

// ─── Sweeps ───
var int lastBslSweep = 0
var int lastSslSweep = 0

if array.size(bslLvls) > 0
    for i = 0 to array.size(bslLvls) - 1
        if not array.get(bslSwept, i) and high > array.get(bslLvls, i)
            array.set(bslSwept, i, true)
            lastBslSweep := bar_index
            if showSweepLabels
                label.new(bar_index, high, "BSL▼", style=label.style_label_down,
                          color=color.new(#ef5350, 40), textcolor=color.white, size=size.tiny)

if array.size(sslLvls) > 0
    for i = 0 to array.size(sslLvls) - 1
        if not array.get(sslSwept, i) and low < array.get(sslLvls, i)
            array.set(sslSwept, i, true)
            lastSslSweep := bar_index
            if showSweepLabels
                label.new(bar_index, low, "SSL▲", style=label.style_label_up,
                          color=color.new(#26a69a, 40), textcolor=color.white, size=size.tiny)

// ─── Trade Tracking ───
var float[] sigDir       = array.new_float()
var float[] sigEntry     = array.new_float()
var float[] sigSL        = array.new_float()
var float[] sigInitSL    = array.new_float()
var float[] sigTP        = array.new_float()
var int[]   sigResult    = array.new_int()
var int[]   sigBar       = array.new_int()
var float[] sigRVal      = array.new_float()
var int[]   sigEntryTime = array.new_int()
var bool[]  sigIsBE      = array.new_bool()
var bool[]  sigIsLocked1 = array.new_bool()
var bool[]  sigIsLocked2 = array.new_bool()

var box[]   sigTpBox     = array.new_box()
var box[]   sigSlBox     = array.new_box()
var line[]  sigEntryL    = array.new_line()

var float cumulativeR    = 0.0
var float peakR          = 0.0
var float maxDrawdown    = 0.0
var int   totalWins      = 0
var int   totalLosses    = 0
var int   totalBE        = 0
var int   totalLocks     = 0

// Consecutive TP and SL tracking
var int curConsecWin     = 0
var int maxConsecWin     = 0
var int curConsecLoss    = 0
var int maxConsecLoss    = 0

// Monthwise tracking
var string[] monthKeys   = array.new_string()
var float[]  monthR      = array.new_float()
var int[]    monthWins   = array.new_int()
var int[]    monthLosses = array.new_int()

curMonthStr = str.tostring(year(time)) + "-" + (month(time) < 10 ? "0" : "") + str.tostring(month(time))

addMonthTrade(float rVal, bool isWin, bool isLoss) =>
    idx = -1
    if array.size(monthKeys) > 0
        for m = 0 to array.size(monthKeys) - 1
            if array.get(monthKeys, m) == curMonthStr
                idx := m
                break
    if idx == -1
        array.push(monthKeys, curMonthStr)
        array.push(monthR, rVal)
        array.push(monthWins, isWin ? 1 : 0)
        array.push(monthLosses, isLoss ? 1 : 0)
    else
        array.set(monthR, idx, array.get(monthR, idx) + rVal)
        if isWin
            array.set(monthWins, idx, array.get(monthWins, idx) + 1)
        if isLoss
            array.set(monthLosses, idx, array.get(monthLosses, idx) + 1)

// Cooldown & Daily controls
var int lastExitBar   = -100
var int consecLosses  = 0
var int dayLossCount  = 0
var int lastTradeDay  = -1

curDay = dayofmonth(time)
if curDay != lastTradeDay
    dayLossCount := 0
    lastTradeDay := curDay

inCooldown = (bar_index - lastExitBar) < cooldownBars or (dayLossCount >= maxDailyLosses)

// ─── Active Trade Management ───
hasActive = false
activeIdx = -1
if array.size(sigResult) > 0
    for i = 0 to array.size(sigResult) - 1
        if array.get(sigResult, i) == 0
            hasActive := true
            activeIdx := i
            break

if hasActive
    d   = array.get(sigDir, activeIdx)
    en  = array.get(sigEntry, activeIdx)
    sl  = array.get(sigSL, activeIdx)
    isl = array.get(sigInitSL, activeIdx)
    tp  = array.get(sigTP, activeIdx)
    sb  = array.get(sigBar, activeIdx)
    rv  = array.get(sigRVal, activeIdx)
    eTm = array.get(sigEntryTime, activeIdx)
    isB = array.get(sigIsBE, activeIdx)
    isL1= array.get(sigIsLocked1, activeIdx)
    isL2= array.get(sigIsLocked2, activeIdx)

    slDist = math.abs(en - isl)
    curProfit = d == 1 ? (high - en) : (en - low)
    curProfitR = slDist > 0 ? (curProfit / slDist) : 0.0
    tradeDurationSec = (time - eTm) / 1000

    // Tier 1: Micro-Breakeven check
    if not isB and curProfitR >= beTriggerR
        array.set(sigIsBE, activeIdx, true)
        array.set(sigSL, activeIdx, en)
        sl := en
        isB := true

    // Tier 2: Lock 1 check (+R Secured)
    if not isL1 and curProfitR >= lock1TriggerR
        lockLevel = d == 1 ? (en + lock1ValR * slDist) : (en - lock1ValR * slDist)
        array.set(sigIsLocked1, activeIdx, true)
        array.set(sigSL, activeIdx, lockLevel)
        sl := lockLevel
        isL1 := true

    // Tier 3: Lock 2 check (+R Secured Runner)
    if not isL2 and curProfitR >= lock2TriggerR
        lockLevel2 = d == 1 ? (en + lock2ValR * slDist) : (en - lock2ValR * slDist)
        array.set(sigIsLocked2, activeIdx, true)
        array.set(sigSL, activeIdx, lockLevel2)
        sl := lockLevel2
        isL2 := true

    // Dynamic visual risk box extension
    if showBoxes and array.size(sigTpBox) > activeIdx
        box.set_right(array.get(sigTpBox, activeIdx), bar_index)
        box.set_right(array.get(sigSlBox, activeIdx), bar_index)
        line.set_x2(array.get(sigEntryL, activeIdx), bar_index)

    // Strategy Native Order Exit logic
    hitTP = d == 1 ? high >= tp : low <= tp
    hitSL = d == 1 ? low <= sl : high >= sl

    if hitTP and tradeDurationSec >= minHoldSeconds
        array.set(sigResult, activeIdx, 1)
        strategy.close("BUY", comment="TP Hit +" + str.tostring(rv, "#.#") + "R")
        strategy.close("SELL", comment="TP Hit +" + str.tostring(rv, "#.#") + "R")
        cumulativeR := cumulativeR + rv
        peakR := math.max(peakR, cumulativeR)
        totalWins := totalWins + 1
        consecLosses := 0
        lastExitBar := bar_index
        addMonthTrade(rv, true, false)

        curConsecWin := curConsecWin + 1
        maxConsecWin := math.max(maxConsecWin, curConsecWin)
        curConsecLoss := 0

        if showBoxes and array.size(sigTpBox) > activeIdx
            bT = array.get(sigTpBox, activeIdx)
            bS = array.get(sigSlBox, activeIdx)
            box.set_right(bT, bar_index)
            box.set_right(bS, bar_index)
            box.set_text(bT, "TP HIT +" + str.tostring(rv, "#.#") + "R")
            line.set_x2(array.get(sigEntryL, activeIdx), bar_index)

        if showExitBadges
            label.new(bar_index, tp, "👑 FULL TP\n+" + str.tostring(rv, "#.#") + "R",
                      color=#00c853, textcolor=color.white, style=d == 1 ? label.style_label_down : label.style_label_up, size=size.small)

    else if hitSL and tradeDurationSec >= minHoldSeconds
        if isL2
            array.set(sigResult, activeIdx, 5)
            strategy.close("BUY", comment="RUNNER +" + str.tostring(lock2ValR, "#.#") + "R")
            strategy.close("SELL", comment="RUNNER +" + str.tostring(lock2ValR, "#.#") + "R")
            cumulativeR := cumulativeR + lock2ValR
            peakR := math.max(peakR, cumulativeR)
            totalLocks := totalLocks + 1
            consecLosses := 0
            lastExitBar := bar_index
            addMonthTrade(lock2ValR, true, false)

            curConsecWin := curConsecWin + 1
            maxConsecWin := math.max(maxConsecWin, curConsecWin)
            curConsecLoss := 0

            if showBoxes and array.size(sigTpBox) > activeIdx
                bT = array.get(sigTpBox, activeIdx)
                bS = array.get(sigSlBox, activeIdx)
                box.set_right(bT, bar_index)
                box.set_right(bS, bar_index)
                box.set_bgcolor(bS, color.new(#00b0ff, 80))
                box.set_border_color(bS, color.new(#00b0ff, 30))
                box.set_text(bS, "RUNNER WIN +" + str.tostring(lock2ValR, "#.#") + "R")
                line.set_x2(array.get(sigEntryL, activeIdx), bar_index)

            if showExitBadges
                label.new(bar_index, sl, "💎 RUNNER\n+" + str.tostring(lock2ValR, "#.#") + "R",
                          color=#00b0ff, textcolor=color.black, style=d == 1 ? label.style_label_up : label.style_label_down, size=size.small)

        else if isL1
            array.set(sigResult, activeIdx, 4)
            strategy.close("BUY", comment="LOCKED +" + str.tostring(lock1ValR, "#.#") + "R")
            strategy.close("SELL", comment="LOCKED +" + str.tostring(lock1ValR, "#.#") + "R")
            cumulativeR := cumulativeR + lock1ValR
            peakR := math.max(peakR, cumulativeR)
            totalLocks := totalLocks + 1
            consecLosses := 0
            lastExitBar := bar_index
            addMonthTrade(lock1ValR, true, false)

            curConsecWin := curConsecWin + 1
            maxConsecWin := math.max(maxConsecWin, curConsecWin)
            curConsecLoss := 0

            if showBoxes and array.size(sigTpBox) > activeIdx
                bT = array.get(sigTpBox, activeIdx)
                bS = array.get(sigSlBox, activeIdx)
                box.set_right(bT, bar_index)
                box.set_right(bS, bar_index)
                box.set_bgcolor(bS, color.new(#2962ff, 80))
                box.set_border_color(bS, color.new(#2962ff, 30))
                box.set_text(bS, "LOCKED WIN +" + str.tostring(lock1ValR, "#.#") + "R")
                line.set_x2(array.get(sigEntryL, activeIdx), bar_index)

            if showExitBadges
                label.new(bar_index, sl, "🔒 LOCKED\n+" + str.tostring(lock1ValR, "#.#") + "R",
                          color=#2962ff, textcolor=color.white, style=d == 1 ? label.style_label_up : label.style_label_down, size=size.small)

        else if isB
            array.set(sigResult, activeIdx, 3)
            strategy.close("BUY", comment="BE +0.0R")
            strategy.close("SELL", comment="BE +0.0R")
            totalBE := totalBE + 1
            lastExitBar := bar_index
            addMonthTrade(0.0, false, false)

            curConsecLoss := 0

            if showBoxes and array.size(sigTpBox) > activeIdx
                bT = array.get(sigTpBox, activeIdx)
                bS = array.get(sigSlBox, activeIdx)
                box.set_right(bT, bar_index)
                box.set_right(bS, bar_index)
                box.set_bgcolor(bS, color.new(#787b86, 85))
                box.set_border_color(bS, color.new(#787b86, 40))
                box.set_text(bS, "BREAKEVEN +0.0R (0 LOSS)")
                line.set_x2(array.get(sigEntryL, activeIdx), bar_index)

            if showExitBadges
                label.new(bar_index, en, "⚪ BREAKEVEN\n+0.0R",
                          color=#787b86, textcolor=color.white, style=d == 1 ? label.style_label_up : label.style_label_down, size=size.small)

        else
            array.set(sigResult, activeIdx, -1)
            strategy.close("BUY", comment="SL Hit -1.0R")
            strategy.close("SELL", comment="SL Hit -1.0R")
            cumulativeR := cumulativeR - 1.0
            curDD = peakR - cumulativeR
            maxDrawdown := math.max(maxDrawdown, curDD)
            totalLosses := totalLosses + 1
            consecLosses := consecLosses + 1
            dayLossCount := dayLossCount + 1
            lastExitBar := bar_index
            addMonthTrade(-1.0, false, true)

            curConsecLoss := curConsecLoss + 1
            maxConsecLoss := math.max(maxConsecLoss, curConsecLoss)
            curConsecWin := 0

            if showBoxes and array.size(sigTpBox) > activeIdx
                bT = array.get(sigTpBox, activeIdx)
                bS = array.get(sigSlBox, activeIdx)
                box.set_right(bT, bar_index)
                box.set_right(bS, bar_index)
                box.set_text(bS, "SL HIT -1.0R")
                line.set_x2(array.get(sigEntryL, activeIdx), bar_index)

            if showExitBadges
                label.new(bar_index, sl, "🛑 STOP LOSS\n-1.0R",
                          color=#d50000, textcolor=color.white, style=d == 1 ? label.style_label_up : label.style_label_down, size=size.small)

// ─── Entry Evaluation ───
if not hasActive and not inCooldown
    lookLong = (bar_index - lastSslSweep) <= expireBars and close > ema
    if lookLong and array.size(bFvgTop) > 0
        for f = array.size(bFvgTop) - 1 to math.max(0, array.size(bFvgTop) - 5)
            fT = array.get(bFvgTop, f)
            fB = array.get(bFvgBot, f)
            fBar = array.get(bFvgBar, f)
            if (bar_index - fBar) <= expireBars and low <= fT and high >= fB
                slP = fB - atrMult * atr
                entryP = close
                tpP = entryP + tpDist
                rDist = entryP - slP
                maxSlAllowed = math.max(2.0, tpDist / 1.5)
                if rDist > 0.4 and rDist < maxSlAllowed
                    winR = (tpP - entryP) / rDist
                    array.push(sigDir,       1)
                    array.push(sigEntry,     entryP)
                    array.push(sigSL,        slP)
                    array.push(sigInitSL,    slP)
                    array.push(sigTP,        tpP)
                    array.push(sigResult,    0)
                    array.push(sigBar,       bar_index)
                    array.push(sigRVal,      winR)
                    array.push(sigEntryTime, time)
                    array.push(sigIsBE,      false)
                    array.push(sigIsLocked1, false)
                    array.push(sigIsLocked2, false)

                    // Native Strategy Order Entry
                    strategy.entry("BUY", strategy.long)
                    strategy.exit("TP/SL", "BUY", limit=tpP, stop=slP)

                    if showBoxes
                        x1 = bar_index
                        x2 = bar_index + 30
                        bTp = box.new(x1, tpP, x2, entryP, border_color=color.new(#26a69a, 30), bgcolor=color.new(#26a69a, 80),
                              text="TP " + str.tostring(tpP, "#.##"), text_color=color.white, text_size=size.small,
                              text_halign=text.align_right, text_valign=text.align_top)
                        bSl = box.new(x1, entryP, x2, slP, border_color=color.new(#ef5350, 30), bgcolor=color.new(#ef5350, 80),
                              text="SL " + str.tostring(slP, "#.##"), text_color=color.white, text_size=size.small,
                              text_halign=text.align_right, text_valign=text.align_bottom)
                        bLn = line.new(x1, entryP, x2, entryP, color=color.white, width=2, style=line.style_dashed)
                        array.push(sigTpBox,  bTp)
                        array.push(sigSlBox,  bSl)
                        array.push(sigEntryL, bLn)

                    if showEntryLabels
                        label.new(bar_index, entryP, "▶ LONG " + str.tostring(entryP, "#.##"),
                                  style=label.style_label_right, color=color.white, textcolor=color.black, size=size.small)

                    lookLong := false
                    break

    lookShort = (bar_index - lastBslSweep) <= expireBars and close < ema
    if lookShort and array.size(sFvgTop) > 0
        for f = array.size(sFvgTop) - 1 to math.max(0, array.size(sFvgTop) - 5)
            fT = array.get(sFvgTop, f)
            fB = array.get(sFvgBot, f)
            fBar = array.get(sFvgBar, f)
            if (bar_index - fBar) <= expireBars and high >= fB and low <= fT
                slP = fT + atrMult * atr
                entryP = close
                tpP = entryP - tpDist
                rDist = slP - entryP
                maxSlAllowed = math.max(2.0, tpDist / 1.5)
                if rDist > 0.4 and rDist < maxSlAllowed
                    winR = (entryP - tpP) / rDist
                    array.push(sigDir,       -1)
                    array.push(sigEntry,     entryP)
                    array.push(sigSL,        slP)
                    array.push(sigInitSL,    slP)
                    array.push(sigTP,        tpP)
                    array.push(sigResult,    0)
                    array.push(sigBar,       bar_index)
                    array.push(sigRVal,      winR)
                    array.push(sigEntryTime, time)
                    array.push(sigIsBE,      false)
                    array.push(sigIsLocked1, false)
                    array.push(sigIsLocked2, false)

                    // Native Strategy Order Entry
                    strategy.entry("SELL", strategy.short)
                    strategy.exit("TP/SL", "SELL", limit=tpP, stop=slP)

                    if showBoxes
                        x1 = bar_index
                        x2 = bar_index + 30
                        bTp = box.new(x1, entryP, x2, tpP, border_color=color.new(#26a69a, 30), bgcolor=color.new(#26a69a, 80),
                              text="TP " + str.tostring(tpP, "#.##"), text_color=color.white, text_size=size.small,
                              text_halign=text.align_right, text_valign=text.align_bottom)
                        bSl = box.new(x1, slP, x2, entryP, border_color=color.new(#ef5350, 30), bgcolor=color.new(#ef5350, 80),
                              text="SL " + str.tostring(slP, "#.##"), text_color=color.white, text_size=size.small,
                              text_halign=text.align_right, text_valign=text.align_top)
                        bLn = line.new(x1, entryP, x2, entryP, color=color.white, width=2, style=line.style_dashed)
                        array.push(sigTpBox,  bTp)
                        array.push(sigSlBox,  bSl)
                        array.push(sigEntryL, bLn)

                    if showEntryLabels
                        label.new(bar_index, entryP, "▶ SHORT " + str.tostring(entryP, "#.##"),
                                  style=label.style_label_right, color=color.white, textcolor=color.black, size=size.small)

                    lookShort := false
                    break

// ─── Dynamic Multi-Row Performance HUD ───
var table hud = table.new(hudPosition, 4, 30, bgcolor=color.new(#10141f, 10), border_color=#2a324b, border_width=2)

if showDashboard and barstate.islast
    table.cell(hud, 0, 0, "💎 MULTI-TIER METRIC", bgcolor=#1e2640, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "VALUE", bgcolor=#1e2640, text_color=color.white, text_size=size.small)
    table.cell(hud, 2, 0, "STATUS", bgcolor=#1e2640, text_color=color.white, text_size=size.small)
    table.cell(hud, 3, 0, "TARGET", bgcolor=#1e2640, text_color=color.white, text_size=size.small)

    int curRow = 1

    // 1. Monthwise Breakdown (Display Recent Months up to 4)
    numMonths = array.size(monthKeys)
    startM = math.max(0, numMonths - 4)
    if numMonths > 0
        for m = startM to numMonths - 1
            if curRow < 20
                mName = array.get(monthKeys, m)
                mVal  = array.get(monthR, m)
                mWins = array.get(monthWins, m)
                mLoss = array.get(monthLosses, m)
                labelTxt = (mName == "2026-09" ? "September 2026" : mName == "2026-10" ? "October 2026" : mName) + " R"

                table.cell(hud, 0, curRow, labelTxt, text_color=color.white, text_size=size.small)
                table.cell(hud, 1, curRow, "+" + str.tostring(mVal, "#.#") + "R (" + str.tostring(mWins) + "W/" + str.tostring(mLoss) + "L)", text_color=#00e676, text_size=size.small)
                table.cell(hud, 2, curRow, mVal >= monthlyTargetR ? "PASSED (>=" + str.tostring(monthlyTargetR, "#") + "R)" : "IN PROGRESS", text_color=mVal >= monthlyTargetR ? #00e676 : #ff9100, text_size=size.small)
                table.cell(hud, 3, curRow, ">= +" + str.tostring(monthlyTargetR, "#.#") + "R / Mo", text_color=#90caf9, text_size=size.small)
                curRow := curRow + 1

    // 2. Total Cumulative Return
    float dualTarget = monthlyTargetR * 2.0
    table.cell(hud, 0, curRow, "Total Net Return", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, "+" + str.tostring(cumulativeR, "#.#") + "R", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, cumulativeR >= dualTarget ? "TARGET REACHED" : "ACTIVE", text_color=cumulativeR >= dualTarget ? #00e676 : #90caf9, text_size=size.small)
    table.cell(hud, 3, curRow, "Target: >= +" + str.tostring(dualTarget, "#.#") + "R", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 3. Dedicated Total Max Drawdown Row
    float ddEquity = maxDrawdown * 0.5
    table.cell(hud, 0, curRow, "Total Max Drawdown", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, "-" + str.tostring(maxDrawdown, "#.#") + "R (-" + str.tostring(ddEquity, "#.#") + "%)", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, ddEquity <= 4.0 ? "PASSED (0.5%)" : "CAUTION", text_color=ddEquity <= 4.0 ? #00e676 : #ff1744, text_size=size.small)
    table.cell(hud, 3, curRow, "< 4.0% Eq DD Limit", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 4. Calmar Ratio
    calmarVal = maxDrawdown > 0 ? (cumulativeR / maxDrawdown) : cumulativeR
    table.cell(hud, 0, curRow, "Calmar Ratio", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(calmarVal, "#.##"), text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, calmarVal >= 4.0 ? "PASSED" : "BELOW", text_color=calmarVal >= 4.0 ? #00e676 : #ff1744, text_size=size.small)
    table.cell(hud, 3, curRow, "Target: > 4.0", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 5. Win Rate
    totClosed = totalWins + totalLocks + totalLosses + totalBE
    wr = (totalWins + totalLocks + totalLosses) > 0 ? ((totalWins + totalLocks) / (totalWins + totalLocks + totalLosses)) * 100.0 : 0.0
    table.cell(hud, 0, curRow, "Win Rate", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(wr, "#.#") + "% (" + str.tostring(totalWins + totalLocks) + "W/" + str.tostring(totalLosses) + "L)", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, wr >= 80.0 ? "SOVEREIGN (>80%)" : "ACTIVE", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "Target: > 80%", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 6. Max Consecutive TP (Wins) & SL (Losses)
    table.cell(hud, 0, curRow, "Max Consec Wins", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(maxConsecWin) + " Wins in a Row", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "EXCELLENT", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "Streak Protection", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    table.cell(hud, 0, curRow, "Max Consec Losses", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(maxConsecLoss) + " Loss Max", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, maxConsecLoss <= 1 ? "SHIELD ACTIVE (1 LOSS MAX)" : "SAFE", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "Zero-Loss-Streak Shield", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 7. Active Preset & Target
    table.cell(hud, 0, curRow, "Active Preset", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(tpPips, "#.#") + " Pips ($" + str.tostring(tpDist, "#.##") + ")", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "ACTIVE", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, resolvedPreset, text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 8. 2-Min Rule Compliance
    table.cell(hud, 0, curRow, "2-Min Min Hold", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, "120s Enforced", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "COMPLIANT", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "FundedSquad / Pipstone", text_color=#90caf9, text_size=size.small)
