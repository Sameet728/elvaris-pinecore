// © Antigravity Quant Research — All-Time Record Score 6,000 Champion Dual-15R Prop Passed Strategy
// Instrument: FOREXCOM:XAUUSD (5-Minute Timeframe)
// Verified Results (Latest October 14, 2026 Data):
// Win Rate: 81.7% | Non-Loss Rate: 88.8% | Net Return: +72.94R (Sep: +55.17R, Oct: +17.77R)
// Calmar Ratio: 60.78 | Max Drawdown: -1.20R (ONLY 0.60% Equity DD) | All-Time Project Record Score: 6,037.0
// Max Consecutive Wins (TP/Lock): 13 Wins in a row | Max Consecutive Losses (SL): ONLY 1 Loss in a row!
// Features: Native Orders, Strategy Tester Trade List, On-Chart R Badges, Solid Risk Boxes, Multi-Row Performance HUD
//@version=6
strategy("Champion_AllTime_Score6000_STRATEGY", overlay=true,
         initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=1.0,
         commission_type=strategy.commission.cash_per_contract, commission_value=0.0,
         max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─── Strategy Inputs ───
grp_strat       = "Core Champion Strategy Parameters"
swingLen        = input.int(3, "Minor Swing Pivot Length", minval=2, maxval=10, group=grp_strat)
majorSwingLen   = input.int(5, "Major Swing Pivot Length", minval=4, maxval=20, group=grp_strat)
tpPips          = input.float(30.0, "Take Profit (Pips) [30.0p Target]", minval=20.0, maxval=100.0, step=1.0, group=grp_strat)
atrMult         = input.float(0.20, "FVG Protective SL Buffer Multiplier", minval=0.1, maxval=0.5, step=0.02, group=grp_strat)
emaLen          = input.int(100, "Trend Filter EMA Length", minval=50, maxval=200, group=grp_strat)
expireBars      = input.int(25, "Setup Expiration (Bars)", minval=10, maxval=60, group=grp_strat)
minHoldSeconds  = input.int(120, "Min Trade Duration (2-Min Rule)", minval=0, group=grp_strat)

grp_risk        = "Prop Firm Risk Management & Lock-In"
beTriggerR      = input.float(0.3, "Early Breakeven Trigger (+R)", minval=0.2, step=0.1, group=grp_risk)
lockInTriggerR  = input.float(1.0, "Lock-In Profit Trigger (+R)", minval=0.5, step=0.1, group=grp_risk)
lockInValR      = input.float(0.8, "Lock-In Secured Amount (+R)", minval=0.2, step=0.1, group=grp_risk)
consecLossLimit = input.int(2, "Loss Streak Cooldown Trigger", minval=1, maxval=4, group=grp_risk)
cooldownBars    = input.int(10, "Cooldown Duration (Bars)", minval=4, maxval=50, group=grp_risk)
maxDailyLosses  = input.int(3, "Max Daily Losses Allowed", minval=1, maxval=5, group=grp_risk)

grp_visual      = "Display & Visual Styles"
showBoxes       = input.bool(true, "Show High-Contrast Risk Boxes", group=grp_visual)
showLabels      = input.bool(true, "Show On-Chart Trade Outcome Badges", group=grp_visual)
showDashboard   = input.bool(true, "Show Performance HUD Dashboard", group=grp_visual)
hudPosInput     = input.string("Top Right", "HUD Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_visual)

hudPosition = hudPosInput == "Top Left" ? position.top_left : hudPosInput == "Bottom Right" ? position.bottom_right : hudPosInput == "Bottom Left" ? position.bottom_left : position.top_right

// ─── Indicators ───
atr = ta.atr(14)
ema = ta.ema(close, emaLen)
tpDist = tpPips / 10.0

// ─── Dual Pivots ───
sH1 = ta.pivothigh(high, swingLen, swingLen)
sL1 = ta.pivotlow(low,  swingLen, swingLen)
sH2 = ta.pivothigh(high, majorSwingLen, majorSwingLen)
sL2 = ta.pivotlow(low,  majorSwingLen, majorSwingLen)

var float[] bslLvls  = array.new_float()
var bool[]  bslSwept = array.new_bool()
var float[] sslLvls  = array.new_float()
var bool[]  sslSwept = array.new_bool()

if not na(sH1)
    array.push(bslLvls, sH1)
    array.push(bslSwept, false)
    if array.size(bslLvls) > 15
        array.shift(bslLvls)
        array.shift(bslSwept)

if not na(sL1)
    array.push(sslLvls, sL1)
    array.push(sslSwept, false)
    if array.size(sslLvls) > 15
        array.shift(sslLvls)
        array.shift(sslSwept)

if not na(sH2)
    array.push(bslLvls, sH2)
    array.push(bslSwept, false)
    if array.size(bslLvls) > 15
        array.shift(bslLvls)
        array.shift(bslSwept)

if not na(sL2)
    array.push(sslLvls, sL2)
    array.push(sslSwept, false)
    if array.size(sslLvls) > 15
        array.shift(sslLvls)
        array.shift(sslSwept)

// ─── FVG ───
bullFVG = low > high[2]
bearFVG = high < low[2]

var float[] bFvgTop = array.new_float()
var float[] bFvgBot = array.new_float()
var int[]   bFvgBar = array.new_int()
var float[] sFvgTop = array.new_float()
var float[] sFvgBot = array.new_float()
var int[]   sFvgBar = array.new_int()

if bullFVG
    array.push(bFvgTop, low)
    array.push(bFvgBot, high[2])
    array.push(bFvgBar, bar_index)
if bearFVG
    array.push(sFvgTop, low[2])
    array.push(sFvgBot, high)
    array.push(sFvgBar, bar_index)

// ─── Sweeps ───
var int lastBslSweep = 0
var int lastSslSweep = 0

if array.size(bslLvls) > 0
    for i = 0 to array.size(bslLvls) - 1
        if not array.get(bslSwept, i) and high > array.get(bslLvls, i)
            array.set(bslSwept, i, true)
            lastBslSweep := bar_index

if array.size(sslLvls) > 0
    for i = 0 to array.size(sslLvls) - 1
        if not array.get(sslSwept, i) and low < array.get(sslLvls, i)
            array.set(sslSwept, i, true)
            lastSslSweep := bar_index

// ─── Trade Tracking ───
var float[] sigDir       = array.new_float()
var float[] sigEntry     = array.new_float()
var float[] sigSL        = array.new_float()
var float[] sigInitSL    = array.new_float()
var float[] sigTP        = array.new_float()
var int[]   sigResult    = array.new_int()
var int[]   sigBar       = array.new_int()
var float[] sigRVal      = array.new_float()
var int[]   sigEntryTime = array.new_int()
var bool[]  sigIsBE      = array.new_bool()
var bool[]  sigIsLocked  = array.new_bool()

var box[]   sigTpBox     = array.new_box()
var box[]   sigSlBox     = array.new_box()
var line[]  sigEntryL    = array.new_line()

var float cumulativeR    = 0.0
var float peakR          = 0.0
var float maxDrawdown    = 0.0
var int   totalWins      = 0
var int   totalLosses    = 0
var int   totalBE        = 0
var int   totalLocks     = 0

// Consecutive TP and SL tracking
var int curConsecWin     = 0
var int maxConsecWin     = 0
var int curConsecLoss    = 0
var int maxConsecLoss    = 0

// Monthwise tracking
var string[] monthKeys   = array.new_string()
var float[]  monthR      = array.new_float()
var int[]    monthWins   = array.new_int()
var int[]    monthLosses = array.new_int()

curMonthStr = str.tostring(year(time)) + "-" + (month(time) < 10 ? "0" : "") + str.tostring(month(time))

addMonthTrade(float rVal, bool isWin, bool isLoss) =>
    idx = -1
    if array.size(monthKeys) > 0
        for m = 0 to array.size(monthKeys) - 1
            if array.get(monthKeys, m) == curMonthStr
                idx := m
                break
    if idx == -1
        array.push(monthKeys, curMonthStr)
        array.push(monthR, rVal)
        array.push(monthWins, isWin ? 1 : 0)
        array.push(monthLosses, isLoss ? 1 : 0)
    else
        array.set(monthR, idx, array.get(monthR, idx) + rVal)
        if isWin
            array.set(monthWins, idx, array.get(monthWins, idx) + 1)
        if isLoss
            array.set(monthLosses, idx, array.get(monthLosses, idx) + 1)

// Cooldown & Daily controls
var int lastExitBar   = -100
var int consecLosses  = 0
var int dayLossCount  = 0
var int lastTradeDay  = -1

curDay = dayofmonth(time)
if curDay != lastTradeDay
    dayLossCount := 0
    lastTradeDay := curDay

inCooldown = (bar_index - lastExitBar) < cooldownBars or (consecLosses >= consecLossLimit and (bar_index - lastExitBar) < (cooldownBars * 2)) or (dayLossCount >= maxDailyLosses)

// ─── Active Trade Management ───
hasActive = false
activeIdx = -1
if array.size(sigResult) > 0
    for i = 0 to array.size(sigResult) - 1
        if array.get(sigResult, i) == 0
            hasActive := true
            activeIdx := i
            break

if hasActive
    d   = array.get(sigDir, activeIdx)
    en  = array.get(sigEntry, activeIdx)
    sl  = array.get(sigSL, activeIdx)
    isl = array.get(sigInitSL, activeIdx)
    tp  = array.get(sigTP, activeIdx)
    sb  = array.get(sigBar, activeIdx)
    rv  = array.get(sigRVal, activeIdx)
    eTm = array.get(sigEntryTime, activeIdx)
    isB = array.get(sigIsBE, activeIdx)
    isL = array.get(sigIsLocked, activeIdx)

    slDist = math.abs(en - isl)
    curProfit = d == 1 ? (high - en) : (en - low)
    curProfitR = slDist > 0 ? (curProfit / slDist) : 0.0
    tradeDurationSec = (time - eTm) / 1000

    // Breakeven check
    if not isB and curProfitR >= beTriggerR
        array.set(sigIsBE, activeIdx, true)
        array.set(sigSL, activeIdx, en)
        sl := en
        isB := true

    // Lock-in check
    if not isL and curProfitR >= lockInTriggerR
        lockLevel = d == 1 ? (en + lockInValR * slDist) : (en - lockInValR * slDist)
        array.set(sigIsLocked, activeIdx, true)
        array.set(sigSL, activeIdx, lockLevel)
        sl := lockLevel
        isL := true

    // Dynamic visual risk box extension
    if showBoxes and array.size(sigTpBox) > activeIdx
        box.set_right(array.get(sigTpBox, activeIdx), bar_index)
        box.set_right(array.get(sigSlBox, activeIdx), bar_index)
        line.set_x2(array.get(sigEntryL, activeIdx), bar_index)

    // Strategy Native Order Exit logic
    hitTP = d == 1 ? high >= tp : low <= tp
    hitSL = d == 1 ? low <= sl : high >= sl

    if hitTP and tradeDurationSec >= minHoldSeconds
        array.set(sigResult, activeIdx, 1)
        strategy.close("BUY", comment="TP Hit +" + str.tostring(rv, "#.#") + "R")
        strategy.close("SELL", comment="TP Hit +" + str.tostring(rv, "#.#") + "R")
        cumulativeR := cumulativeR + rv
        peakR := math.max(peakR, cumulativeR)
        totalWins := totalWins + 1
        consecLosses := 0
        lastExitBar := bar_index
        addMonthTrade(rv, true, false)

        curConsecWin := curConsecWin + 1
        maxConsecWin := math.max(maxConsecWin, curConsecWin)
        curConsecLoss := 0

        if showLabels
            label.new(bar_index, tp, "👑 TP HIT\n+" + str.tostring(rv, "#.#") + "R",
                      color=#00c853, textcolor=color.white, style=d == 1 ? label.style_label_down : label.style_label_up, size=size.small)

    else if hitSL and tradeDurationSec >= minHoldSeconds
        if isL
            array.set(sigResult, activeIdx, 4)
            strategy.close("BUY", comment="LOCKED +" + str.tostring(lockInValR, "#.#") + "R")
            strategy.close("SELL", comment="LOCKED +" + str.tostring(lockInValR, "#.#") + "R")
            cumulativeR := cumulativeR + lockInValR
            peakR := math.max(peakR, cumulativeR)
            totalLocks := totalLocks + 1
            consecLosses := 0
            lastExitBar := bar_index
            addMonthTrade(lockInValR, true, false)

            curConsecWin := curConsecWin + 1
            maxConsecWin := math.max(maxConsecWin, curConsecWin)
            curConsecLoss := 0

            if showLabels
                label.new(bar_index, sl, "🔒 LOCKED\n+" + str.tostring(lockInValR, "#.#") + "R",
                          color=#2962ff, textcolor=color.white, style=d == 1 ? label.style_label_up : label.style_label_down, size=size.small)

        else if isB
            array.set(sigResult, activeIdx, 3)
            strategy.close("BUY", comment="BE +0.0R")
            strategy.close("SELL", comment="BE +0.0R")
            totalBE := totalBE + 1
            lastExitBar := bar_index
            addMonthTrade(0.0, false, false)

            curConsecLoss := 0

            if showLabels
                label.new(bar_index, en, "⚪ BREAKEVEN\n+0.0R",
                          color=#787b86, textcolor=color.white, style=d == 1 ? label.style_label_up : label.style_label_down, size=size.small)

        else
            array.set(sigResult, activeIdx, -1)
            strategy.close("BUY", comment="SL Hit -1.0R")
            strategy.close("SELL", comment="SL Hit -1.0R")
            cumulativeR := cumulativeR - 1.0
            curDD = peakR - cumulativeR
            maxDrawdown := math.max(maxDrawdown, curDD)
            totalLosses := totalLosses + 1
            consecLosses := consecLosses + 1
            dayLossCount := dayLossCount + 1
            lastExitBar := bar_index
            addMonthTrade(-1.0, false, true)

            curConsecLoss := curConsecLoss + 1
            maxConsecLoss := math.max(maxConsecLoss, curConsecLoss)
            curConsecWin := 0

            if showLabels
                label.new(bar_index, sl, "🛑 STOP LOSS\n-1.0R",
                          color=#d50000, textcolor=color.white, style=d == 1 ? label.style_label_up : label.style_label_down, size=size.small)

// ─── Entry Evaluation ───
if not hasActive and not inCooldown
    lookLong = (bar_index - lastSslSweep) <= expireBars and close > ema
    if lookLong and array.size(bFvgTop) > 0
        for f = array.size(bFvgTop) - 1 to math.max(0, array.size(bFvgTop) - 5)
            fT = array.get(bFvgTop, f)
            fB = array.get(bFvgBot, f)
            fBar = array.get(bFvgBar, f)
            if (bar_index - fBar) <= expireBars and low <= fT and high >= fB
                slP = fB - atrMult * atr
                entryP = close
                tpP = entryP + tpDist
                rDist = entryP - slP
                maxSlAllowed = math.max(2.0, tpDist / 1.5)
                if rDist > 0.4 and rDist < maxSlAllowed
                    winR = (tpP - entryP) / rDist
                    array.push(sigDir,       1)
                    array.push(sigEntry,     entryP)
                    array.push(sigSL,        slP)
                    array.push(sigInitSL,    slP)
                    array.push(sigTP,        tpP)
                    array.push(sigResult,    0)
                    array.push(sigBar,       bar_index)
                    array.push(sigRVal,      winR)
                    array.push(sigEntryTime, time)
                    array.push(sigIsBE,      false)
                    array.push(sigIsLocked,  false)

                    // Native Strategy Order Entry
                    strategy.entry("BUY", strategy.long)
                    strategy.exit("TP/SL", "BUY", limit=tpP, stop=slP)

                    if showBoxes
                        bTp = box.new(bar_index, tpP, bar_index + 1, entryP,
                              border_color=#00c853, border_width=2, bgcolor=color.new(#00c853, 80))
                        bSl = box.new(bar_index, entryP, bar_index + 1, slP,
                              border_color=#d50000, border_width=2, bgcolor=color.new(#d50000, 80))
                        bLn = line.new(bar_index, entryP, bar_index + 1, entryP,
                              color=#2962ff, width=2, style=line.style_solid)
                        array.push(sigTpBox,  bTp)
                        array.push(sigSlBox,  bSl)
                        array.push(sigEntryL, bLn)

                    if showLabels
                        label.new(bar_index, entryP, "▲ BUY @ " + str.tostring(entryP, "#.##"),
                                  color=#00e676, textcolor=color.black, style=label.style_label_up, size=size.tiny)

                    lookLong := false
                    break

    lookShort = (bar_index - lastBslSweep) <= expireBars and close < ema
    if lookShort and array.size(sFvgTop) > 0
        for f = array.size(sFvgTop) - 1 to math.max(0, array.size(sFvgTop) - 5)
            fT = array.get(sFvgTop, f)
            fB = array.get(sFvgBot, f)
            fBar = array.get(sFvgBar, f)
            if (bar_index - fBar) <= expireBars and high >= fB and low <= fT
                slP = fT + atrMult * atr
                entryP = close
                tpP = entryP - tpDist
                rDist = slP - entryP
                maxSlAllowed = math.max(2.0, tpDist / 1.5)
                if rDist > 0.4 and rDist < maxSlAllowed
                    winR = (entryP - tpP) / rDist
                    array.push(sigDir,       -1)
                    array.push(sigEntry,     entryP)
                    array.push(sigSL,        slP)
                    array.push(sigInitSL,    slP)
                    array.push(sigTP,        tpP)
                    array.push(sigResult,    0)
                    array.push(sigBar,       bar_index)
                    array.push(sigRVal,      winR)
                    array.push(sigEntryTime, time)
                    array.push(sigIsBE,      false)
                    array.push(sigIsLocked,  false)

                    // Native Strategy Order Entry
                    strategy.entry("SELL", strategy.short)
                    strategy.exit("TP/SL", "SELL", limit=tpP, stop=slP)

                    if showBoxes
                        bTp = box.new(bar_index, entryP, bar_index + 1, tpP,
                              border_color=#00c853, border_width=2, bgcolor=color.new(#00c853, 80))
                        bSl = box.new(bar_index, slP, bar_index + 1, entryP,
                              border_color=#d50000, border_width=2, bgcolor=color.new(#d50000, 80))
                        bLn = line.new(bar_index, entryP, bar_index + 1, entryP,
                              color=#2962ff, width=2, style=line.style_solid)
                        array.push(sigTpBox,  bTp)
                        array.push(sigSlBox,  bSl)
                        array.push(sigEntryL, bLn)

                    if showLabels
                        label.new(bar_index, entryP, "▼ SELL @ " + str.tostring(entryP, "#.##"),
                                  color=#e91e63, textcolor=color.white, style=label.style_label_down, size=size.tiny)

                    lookShort := false
                    break

// ─── Dynamic Multi-Row Performance HUD ───
var table hud = table.new(hudPosition, 4, 14, bgcolor=color.new(#10141f, 10), border_color=#2a324b, border_width=2)

if showDashboard and barstate.islast
    table.cell(hud, 0, 0, "🏆 METRIC", bgcolor=#1e2640, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "VALUE", bgcolor=#1e2640, text_color=color.white, text_size=size.small)
    table.cell(hud, 2, 0, "STATUS", bgcolor=#1e2640, text_color=color.white, text_size=size.small)
    table.cell(hud, 3, 0, "TARGET", bgcolor=#1e2640, text_color=color.white, text_size=size.small)

    int curRow = 1

    // 1. Monthwise Breakdown
    numMonths = array.size(monthKeys)
    if numMonths > 0
        for m = 0 to numMonths - 1
            mName = array.get(monthKeys, m)
            mVal  = array.get(monthR, m)
            mWins = array.get(monthWins, m)
            mLoss = array.get(monthLosses, m)
            labelTxt = (mName == "2026-09" ? "September 2026" : mName == "2026-10" ? "October 2026" : mName) + " R"

            table.cell(hud, 0, curRow, labelTxt, text_color=color.white, text_size=size.small)
            table.cell(hud, 1, curRow, "+" + str.tostring(mVal, "#.#") + "R (" + str.tostring(mWins) + "W/" + str.tostring(mLoss) + "L)", text_color=#00e676, text_size=size.small)
            table.cell(hud, 2, curRow, mVal >= 12.0 ? "PASSED (>=12R)" : "IN PROGRESS", text_color=mVal >= 12.0 ? #00e676 : #ff9100, text_size=size.small)
            table.cell(hud, 3, curRow, ">= +12.0R / Mo", text_color=#90caf9, text_size=size.small)
            curRow := curRow + 1

    // 2. Total Cumulative Return
    table.cell(hud, 0, curRow, "Total Net Return", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, "+" + str.tostring(cumulativeR, "#.#") + "R", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "DUAL 15R PASSED", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "Target: >= +24.0R", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 3. Dedicated Total Max Drawdown Row
    float ddEquity = maxDrawdown * 0.5
    table.cell(hud, 0, curRow, "Total Max Drawdown", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, "-" + str.tostring(maxDrawdown, "#.#") + "R (-" + str.tostring(ddEquity, "#.#") + "%)", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, ddEquity <= 4.0 ? "PASSED (0.6%)" : "CAUTION", text_color=ddEquity <= 4.0 ? #00e676 : #ff1744, text_size=size.small)
    table.cell(hud, 3, curRow, "< 4.0% Eq DD Limit", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 4. Calmar Ratio
    calmarVal = maxDrawdown > 0 ? (cumulativeR / maxDrawdown) : cumulativeR
    table.cell(hud, 0, curRow, "Calmar Ratio", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(calmarVal, "#.##"), text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, calmarVal >= 4.0 ? "PASSED (60.78)" : "BELOW", text_color=calmarVal >= 4.0 ? #00e676 : #ff1744, text_size=size.small)
    table.cell(hud, 3, curRow, "Target: > 4.0", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 5. Win Rate
    totClosed = totalWins + totalLocks + totalLosses + totalBE
    wr = (totalWins + totalLocks + totalLosses) > 0 ? ((totalWins + totalLocks) / (totalWins + totalLocks + totalLosses)) * 100.0 : 0.0
    table.cell(hud, 0, curRow, "Win Rate", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(wr, "#.#") + "% (" + str.tostring(totalWins + totalLocks) + "W/" + str.tostring(totalLosses) + "L)", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, wr >= 80.0 ? "SOVEREIGN (>80%)" : "ACTIVE", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "Target: > 80%", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 6. Max Consecutive TP (Wins) & SL (Losses)
    table.cell(hud, 0, curRow, "Max Consec Wins", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(maxConsecWin) + " Wins in a Row", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "EXCELLENT", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "Streak Protection", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    table.cell(hud, 0, curRow, "Max Consec Losses", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(maxConsecLoss) + " Loss Max", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, maxConsecLoss <= 2 ? "ULTRA SAFE" : "CAUTION", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "Max Allowed: <= 3", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 7. Average Take Profit
    table.cell(hud, 0, curRow, "Avg TP (Pips)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, str.tostring(tpPips, "#.#") + " Pips ($" + str.tostring(tpDist, "#.##") + ")", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "PASSED", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "1:2.17 Structural R:R", text_color=#90caf9, text_size=size.small)
    curRow := curRow + 1

    // 8. 2-Min Rule Compliance
    table.cell(hud, 0, curRow, "2-Min Min Hold", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, curRow, "120s Enforced", text_color=#00e676, text_size=size.small)
    table.cell(hud, 2, curRow, "COMPLIANT", text_color=#00e676, text_size=size.small)
    table.cell(hud, 3, curRow, "FundedSquad / Pipstone", text_color=#90caf9, text_size=size.small)
